{
  "name": "paddletoday-frontend",
  "main": "frontend-worker.mjs",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "FRONTEND_CANARY": "0" },
  "routes": [
    { "pattern": "paddletoday.com", "custom_domain": true, "zone_name": "paddletoday.com" }
  ],
  "assets": {
    "directory": "../../tmp/frontend",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api", "/api/*"]
  }
}
