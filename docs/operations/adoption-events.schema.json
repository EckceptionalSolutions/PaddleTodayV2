{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Privacy-safe aggregate adoption events",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name"],
    "properties": {
      "name": { "type": "string" },
      "at": { "type": "string" },
      "route": { "type": "string" },
      "state": { "type": "string" },
      "properties": { "type": "object", "additionalProperties": true }
    },
    "additionalProperties": false
  }
}
