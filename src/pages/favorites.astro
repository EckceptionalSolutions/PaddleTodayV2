---
import BaseLayout from '../layouts/BaseLayout.astro';
import FavoriteButton from '../components/FavoriteButton.astro';
---

<BaseLayout
  title="Paddle Today | Saved routes"
  description="Check your saved routes and condition alerts in Paddle Today."
  noindex={true}
>
  <section class="decision-section favorites-page" data-favorites-page>
    <div class="section-head section-head--stacked favorites-page__head">
      <div>
        <h1 class="section-title">Saved routes</h1>
      </div>
      <p class="muted section-head__note" data-favorites-summary role="status">
        Checking saved routes on this device.
      </p>
      <button class="filter-chip" type="button" data-favorites-refresh>Refresh calls</button>
    </div>

    <p class="favorites-page__device-note muted">
      Saved routes are stored in this browser. Route alerts are configured separately when you want condition notifications.
    </p>

    <section class="summary-map-shell favorites-page__map-shell" data-favorites-map-shell hidden>
      <div class="summary-map-copy favorites-page__map-copy">
        <div class="summary-map-results-head">
          <p class="eyebrow">Map view</p>
          <h2 class="section-title favorites-page__map-title">Saved route map</h2>
        </div>
        <p class="summary-map-copy__lede favorites-page__map-lede">
          Scan where saved routes sit and open any marker for the current score snapshot.
        </p>
        <p class="muted favorites-page__map-note" data-favorites-map-copy>
          Loading current saved-route locations.
        </p>
      </div>

      <div class="summary-map-frame favorites-page__map-frame">
        <div class="summary-map favorites-page__map" data-favorites-map aria-label="Map showing saved routes"></div>
        <div class="summary-map-footer">
          <div class="summary-map-legend" aria-hidden="true">
            <span class="summary-map-legend__item">
              <span class="summary-map-legend__marker summary-map-legend__marker--great">90</span>
              Strong conditions
            </span>
            <span class="summary-map-legend__item">
              <span class="summary-map-legend__marker summary-map-legend__marker--good">70</span>
              Good conditions
            </span>
            <span class="summary-map-legend__item">
              <span class="summary-map-legend__marker summary-map-legend__marker--marginal">55</span>
              Watch closely
            </span>
            <span class="summary-map-legend__item">
              <span class="score-map-marker score-map-marker--no-go score-map-marker--confidence-low">15</span>
              Skip
            </span>
          </div>
          <p class="muted summary-map__status favorites-page__map-status" data-favorites-map-status>
            Loading saved-route map.
          </p>
        </div>
      </div>
    </section>

    <div class="favorites-page__empty decision-placeholder" data-favorites-empty hidden>
      <p class="favorites-page__empty-title">No saved routes yet.</p>
      <p class="muted favorites-page__empty-copy">
        Save a route from a route page or route card and it will show up here.
      </p>
      <div class="favorites-page__empty-actions">
        <a class="river-link river-link--inline" href="/explore/">Browse routes</a>
        <a class="river-link river-link--inline river-link--ghost" href="/">Find today's best pick</a>
      </div>
    </div>

    <div class="favorites-page__grid" data-favorites-grid hidden></div>
  </section>

  <template data-favorites-card-template>
    <article class="river-card river-card--decision river-card--route favorites-card" data-favorite-card>
      <div class="river-card__eyebrow-row">
        <div class="river-card__eyebrow-meta">
          <span class="river-card__kind">Route</span>
          <p class="river-card__state" data-field="favorite-state"></p>
        </div>
        <FavoriteButton className="favorite-toggle favorite-toggle--card" hidden />
      </div>

      <div class="river-card__top">
        <div class="river-card__title-block">
          <h2 class="river-card__title">
            <a class="title-link" href="/" data-field="favorite-title-link"></a>
          </h2>
          <p class="river-card__subtitle" data-field="favorite-route"></p>
          <p class="river-card__segment" data-field="favorite-segment" hidden></p>
        </div>
      </div>

      <p class="river-card__verdict" data-field="favorite-verdict"></p>
      <div class="river-card__scoreline">
        <div class="score-orb" aria-label="Saved route score">
          <span class="score-orb__score" data-field="favorite-score"></span>
          <span class="score-orb__rating" data-field="favorite-rating"></span>
        </div>
        <div class="river-card__score-copy">
          <div class="river-card__weather" data-field="favorite-weather" hidden></div>
        </div>
      </div>
      <section class="river-card__facts-section" data-field="favorite-facts-section" hidden>
        <p class="river-card__facts-label sr-only">Route facts</p>
        <div class="river-card__facts" data-field="favorite-facts"></div>
      </section>
      <p class="river-card__explanation" data-field="favorite-summary"></p>
      <p class="saved-route-changes" data-field="favorite-changes" hidden></p>
          <details class="river-card__details">
        <summary>Condition details</summary>
        <div class="river-card__details-body">
          <p class="river-card__meta-line" data-field="favorite-meta"></p>
          <div class="river-card__signal-line" data-field="favorite-signal"></div>
        </div>
      </details>
      <p class="favorites-card__saved-at muted" data-field="favorite-saved-at"></p>

      <div class="favorite-notes">
        <p class="favorite-notes__text" data-field="favorite-notes-text" hidden></p>
        <button class="filter-chip filter-chip--quiet" type="button" data-favorite-notes>Add personal note</button>
      </div>

      <a class="river-link river-link--wide" href="/" data-field="favorite-link">View route</a>
    </article>
  </template>

  <dialog class="favorite-notes-dialog" data-favorite-notes-dialog aria-labelledby="favorite-notes-title" aria-describedby="favorite-notes-help">
    <form>
      <h2 id="favorite-notes-title" data-notes-title>Personal notes</h2>
      <p class="muted" id="favorite-notes-help">Only stored in this browser. Add parking, shuttle, or launch reminders.</p>
      <label for="favorite-notes-input">Your note</label>
      <textarea id="favorite-notes-input" rows="6" maxlength="2000" placeholder="Parking, shuttle arrangements, preferred launch…"></textarea>
      <p class="muted">Up to 2,000 characters. Clear the note and save to remove it.</p>
      <p class="favorite-notes-dialog__status" data-notes-status role="status"></p>
      <div class="favorite-notes-dialog__actions">
        <button class="filter-chip" type="button" data-notes-cancel>Cancel</button>
        <button class="filter-chip" type="submit">Save note</button>
      </div>
    </form>
  </dialog>

  <script>
    import '../scripts/favorites-page.js';
  </script>
</BaseLayout>
