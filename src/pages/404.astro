---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Paddle Today" description="Find your way back to Paddle Today routes and planning tools." noindex>
  <section class="not-found" aria-labelledby="not-found-title">
    <p class="eyebrow">Page not found</p>
    <h1 id="not-found-title">Let's find your next paddle.</h1>
    <p>This link may have changed, or the page may no longer be available.</p>
    <nav aria-label="Find another route">
      <a class="river-link" href="/">Today's routes</a>
      <a class="river-link" href="/explore/">Explore the map</a>
      <a class="river-link" href="/states/">Browse by state</a>
    </nav>
  </section>
</BaseLayout>

<style>
  .not-found { max-width: 48rem; margin: 3rem auto; padding: 1.5rem; }
  h1 { font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1.15; }
  p { max-width: 38rem; line-height: 1.6; }
  nav { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1.5rem; }
  nav a { min-height: 44px; display: inline-flex; align-items: center; }
</style>
