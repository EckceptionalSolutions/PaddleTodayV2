              <ul>
                <li><a href={routeSlugHref('truckee-river-crystal-peak-mayberry')}>Crystal Peak Park to Mayberry Park</a> · about 8 mi</li>
                <li><a href={routeSlugHref('truckee-river-mayberry-cottonwood')}>Mayberry Park to Cottonwood Park</a> · about 10 mi</li>
                <li><a href={routeSlugHref('truckee-river-cottonwood-lockwood')}>Cottonwood Park to Lockwood Trailhead Park</a> · about 5 mi</li>
