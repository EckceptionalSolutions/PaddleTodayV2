                    aria-pressed={active ? 'true' : 'false'}
                    aria-label={`Show ${route.reach} on the map`}
                    data-analytics-event="corridor_trip_selected"
                    data-analytics-route={route.slug}
                    data-analytics-corridor={route.conditionZoneId || route.slug}
                    data-analytics-source="river_hub"
                  >
                    <span class="route-choice__copy">
                      <span class="route-choice__eyebrow">
                        {active ? <span class="route-choice__on-map">On map</span> : <>{route.state} · {route.region}</>}
                      </span>
                      <strong class="route-choice__title">{route.reach}</strong>
                      <span class="route-choice__facts">
                        {route.logistics?.distanceLabel ? <span class="route-choice__fact route-choice__fact--distance">{route.logistics.distanceLabel}</span> : null}
                        {route.logistics?.estimatedPaddleTime ? <span class="route-choice__fact route-choice__fact--time">{shortTimeLabel(route.logistics.estimatedPaddleTime)}</span> : null}
                        <span class="route-choice__fact">{route.profile.difficulty} difficulty</span>
                      </span>
                    </span>
                    <span class="route-choice__score-compact">
                      <strong>--</strong>
                      <span data-group-initial-score>{route.scoreEligibility === 'planning' ? 'Planning route' : 'Loading'}</span>
                    </span>
                  </button>
                  {isWillimanticHub || isAnimasHub || isHousatonicHub ? (
                    <details class="route-choice__trip-notes">
                      <summary>{isAnimasHub || isHousatonicHub ? 'Access, flow, and safety notes' : 'Access, gauge, and safety notes'}</summary>
                      <div>
                        <p>{route.logistics?.summary || route.summary}</p>
                        <p>
                          <strong>Put-in:</strong> {route.putIn?.name || 'See linked trail guide'}.
                          {' '}
                          <strong>Take-out:</strong> {route.takeOut?.name || 'See linked trail guide'}.
                        </p>
                        <p>
                          <strong>Gauge:</strong> {route.gaugeSource.siteName}
                          {typeof (route.profile.idealMin ?? route.profile.tooLow) === 'number'
                            ? `; use ${route.profile.idealMin ?? route.profile.tooLow} ${route.gaugeSource.unit} as this route’s published planning floor.`
                            : '.'}
                          {' '}This is route-specific planning guidance; check the live reading and trend before launch.
                        </p>
                        {route.logistics?.accessCaveats?.length ? (
                          <ul>{route.logistics.accessCaveats.map((note) => <li>{note}</li>)}</ul>
                        ) : null}
                        {route.logistics?.watchFor?.length ? (
                          <ul>{route.logistics.watchFor.map((note) => <li>{note}</li>)}</ul>
                        ) : null}
                        {route.safetyProfile?.safetyNotes?.length ? (
                          <ul>{route.safetyProfile.safetyNotes.map((note) => <li>{note}</li>)}</ul>
                        ) : null}
                      </div>
                    </details>
                  ) : (
                    <a class="river-link river-link--inline route-choice__details-link" href={routeDetailHref(route)}>
                      {hasConsolidatedTrips ? 'View trip option' : 'View route'}
                    </a>
                  )}
                </article>
              );
            })}
          </div>
        </div>

        <div class="river-route-picker__map-column" id="river-hub-map-view">
          <div class="river-route-picker__selected" data-group-selected-summary aria-live="polite">
            <div class="river-route-picker__selected-copy">
              <span class="eyebrow">Your trip</span>
              <strong>{staticSelectedRoute?.reach}</strong>
              <span>
                {[staticSelectedRoute?.logistics?.distanceLabel, shortTimeLabel(staticSelectedRoute?.logistics?.estimatedPaddleTime), staticSelectedRoute?.profile.difficulty].filter(Boolean).join(' · ')}
              </span>
            </div>
            {staticSelectedRoute ? (
              <FavoriteButton
                className="favorite-toggle favorite-toggle--card favorite-toggle--inline river-route-picker__selected-save"
                slug={staticSelectedRoute.slug}
                name={group.name}
                reach={staticSelectedRoute.reach}
                state={staticSelectedRoute.state}
                region={staticSelectedRoute.region}
                url={routeDetailHref(staticSelectedRoute)}
              />
            ) : null}
            <div class="river-route-picker__selected-decision">
              <strong>--</strong>
              <span>{staticSelectedRoute?.scoreEligibility === 'planning' ? 'Planning only · No live score' : 'Loading conditions'}</span>
            </div>
            {staticSelectedRoute ? (
              <div class="river-route-picker__selected-actions">
                <a class="river-link river-link--inline" href={routeDetailHref(staticSelectedRoute)}>{hasConsolidatedTrips ? 'View trip option' : 'View route details'}</a>
              </div>
            ) : null}
          </div>
          <div class="river-group-page__map-shell" data-map-skip-region>
            <a class="map-skip-link" href="#trip-map-end">Skip map</a>
            <div class="river-group-page__map" data-group-map aria-label={`${group.name} trip map`}></div>
            <div class="river-hub-map-legend" aria-label="Trip map legend">
              <span><i class="river-hub-map-legend__line river-hub-map-legend__line--strong"></i>Strong conditions</span>
              <span><i class="river-hub-map-legend__line river-hub-map-legend__line--good"></i>Good conditions</span>
              <span><i class="river-hub-map-legend__line river-hub-map-legend__line--fair"></i>Watch closely</span>
              <span><i class="river-hub-map-legend__line river-hub-map-legend__line--no-go"></i>Skip</span>
              <span><i class="river-hub-map-legend__line river-hub-map-legend__line--planning"></i>Planning only</span>
              <span><i class="river-hub-map-legend__line river-hub-map-legend__line--unavailable"></i>Call unavailable</span>
              {group.riverId === 'mississippi-river' ? <span><i class="river-hub-map-legend__notice">!</i>Lock, portage, or coverage gap</span> : null}
            </div>
            <div class="river-route-picker__map-empty" data-group-map-empty role="status" hidden>
              <div class="river-route-picker__map-empty-card">
                <span class="eyebrow">Nothing in this view</span>
                <strong>No trips match these filters</strong>
                <p class="muted">Clear a filter to see more of this river.</p>
                <button class="river-link river-link--inline" type="button" data-group-map-empty-reset>
                  Show all trips
                </button>
              </div>
            </div>
            <p class="muted river-group-page__map-status" data-group-map-status role="status" tabindex="-1">
              Loading trip map.
            </p>
            <button class="filter-chip river-group-page__map-retry" type="button" data-group-map-retry hidden>Retry trip map</button>
            <span class="map-skip-target" id="trip-map-end" tabindex="-1">End of map</span>
          </div>
        </div>
      </div>
    </section>

    <section class="river-group-page__panel river-hub-context" aria-labelledby="river-hub-context-title">
      <div class="river-group-page__section-head">
        <div>
          <p class="eyebrow section-label">
            <FeatureIcon name="compass" size={16} />
            River overview
          </p>
          <h2 class="section-title" id="river-hub-context-title">{group.name} paddle planning</h2>
        </div>
        <p class="muted river-group-page__section-note">
          What to verify before you commit.
        </p>
      </div>

      <div class="river-hub-context__grid">
        <article class="river-hub-context__item">
          <h3>Water levels</h3>
          <p>
            {gaugeNames.length === 1
              ? `These ${group.name} routes use ${gaugeNames[0]} as the main gauge reference.`
              : `These ${group.name} routes use ${gaugeNames.length} gauge references depending on the stretch.`}
          </p>
        </article>
        <article class="river-hub-context__item">
          <h3>Route options</h3>
          <p>
            {isRussianRiverHub
              ? `Compare all ${group.routeCount} endpoint combinations here. Six source-backed trips keep standalone pages; the remaining options stay selectable with their own mileage, access, shuttle, and hazard notes. The upper, middle, and lower reaches use different guide and gauge references.`
              : isGreenRiverHub
              ? `Compare all ${group.routeCount} Green River trip choices across the Upper Green, Hart County, and Mammoth Cave. Eight source-backed trips keep standalone pages; the other 24 remain available here with their endpoint, mileage, access, and hazard details. Eleven cross-zone combinations are planning-only because their gauge guidance cannot be combined into one route score.`
              : isBlackfootHub
              ? `Compare all ${group.routeCount} endpoint combinations here. Five source-documented runs keep standalone pages; the other 31 remain selectable as trip options. Route-specific flow scores are limited to those five named reaches; the rest show the Bonner gauge as context only.`
              : isAnimasHub
              ? `Compare all ${group.routeCount} Animas trip choices here. Five source-backed sections keep standalone pages; the five composite options remain selectable with their own endpoints, mileage, bailout access, gauge references, and hazards.`
              : isSanJuanHub
              ? `Compare all ${group.routeCount} San Juan trip choices here. Five named access sections keep standalone pages; six longer combinations remain selectable with their own endpoints, mileage, intermediate access, gauge references, and hazards.`
              : isChattahoocheeHub
              ? `Compare all 79 Chattahoochee trips here. Eight focused recreation-area sections keep standalone guides; 68 overlapping NRA combinations remain selectable as route cards. The Upper Chattahoochee, Powers Island–Paces Mill, and Columbus routes keep separate guides for their different paddling contexts.`
              : isHousatonicHub
              ? `Compare all ${group.routeCount} Berkshire Housatonic trip choices here. Nine reach-specific sections keep standalone pages; six longer endpoint combinations remain selectable with their own access, mileage, gauge, portage, and safety details.`
              : isWillimanticHub
              ? `Compare all ${group.routeCount} trip combinations here, grouped around the three official water-trail stretches. Each option retains its own access, mileage, gauge cue, difficulty, and hazard notes.`
              : isWillametteHub
              ? `Compare all ${group.routeCount} endpoint combinations here. Five source-backed trips keep standalone pages; the other 45 remain selectable here with their own mileage, access, camping, and hazard notes. Three trips within the Alton Baker–Harrisburg flow-guidance reach have scores; the rest are planning-only.`
              : isBlackCreekHub
              ? `Compare all ${group.routeCount} landing combinations here. The six adjacent reaches documented by Seven Rivers have individual pages; longer combinations and the Ashe Nursery alternative remain available as trip options.`
              : isFloydsForkHub
              ? `Compare all ${group.routeCount} Floyds Fork choices here. Thirteen detailed guides cover 11 routes published by KDFWR or The Parklands plus two longer options; the other eight combinations remain selectable with their own route details.`
              : isSaukRiverHub
              ? `Compare all ${group.routeCount} Sauk River endpoint choices here. Seven focused guides cover the DNR-recommended trips, its Frogtown extension, and useful St. Martin and lower-river access pairs; the other 14 combinations stay selectable with their own mileage, access, and hazard details.`
              : isTruckeeHub
              ? `Compare all ${group.routeCount} Truckee River choices here. Six source-documented pages cover the upper Floriston run, three Reno–Sparks sections, and two lower-river reaches. The other 18 endpoint combinations remain selectable with their own distance, access, gauge, and hazard details.`
              : `Compare ${group.routeCount} ${routeLabel} (${scoredRouteCount} scored · ${planningRouteCount} planning) across ${regionSummary}. Open a route page for put-in, take-out, distance, source confidence, and access notes.`}
          </p>
        </article>
        <article class="river-hub-context__item">
          <h3>Difficulty</h3>
          <p>
            {difficultyLabels.length > 0
              ? `${group.name} routes here are marked ${difficultyLabels.join(' and ').toLowerCase()}, so choose the stretch that fits your group and conditions.`
              : `Difficulty varies by stretch, water level, weather, and access logistics.`}
          </p>
        </article>
      </div>

      {isFloydsForkHub ? (
        <div class="river-hub-context__source-guide" aria-labelledby="floyds-fork-sections-title">
          <div class="river-group-page__section-head">
            <div>
              <p class="eyebrow section-label">KDFWR and The Parklands route guides</p>
              <h3 class="section-title" id="floyds-fork-sections-title">Choose a Floyds Fork section</h3>
            </div>
            <p class="muted river-group-page__section-note">
              Start with the named routes below. Every endpoint combination remains available in the trip picker.
            </p>
          </div>

          <div class="river-hub-context__grid">
            <article class="river-hub-context__item">
              <h3>Six KDFWR access legs</h3>
              <ol>
                <li><a href="/rivers/floyds-fork-north-beckley-creekside/">North Beckley to Creekside</a> · 2.1 mi</li>
                <li><a href="/rivers/floyds-fork-creekside-fisherville/">Creekside to Fisherville</a> · 4.3 mi</li>
                <li><a href="/rivers/floyds-fork-fisherville-cane-run/">Fisherville to Cane Run</a> · 4.2 mi</li>
                <li><a href="/rivers/floyds-fork-cane-run-seaton-valley/">Cane Run to Seaton Valley</a> · 3.1 mi</li>
                <li><a href="/rivers/floyds-fork-seaton-valley-broad-run-valley/">Seaton Valley to Broad Run Valley</a> · 3.4 mi</li>
                <li><a href="/rivers/floyds-fork-broad-run-valley-cliffside/">Broad Run Valley to Cliffside</a> · 2.1 mi</li>
              </ol>
            </article>
            <article class="river-hub-context__item">
              <h3>Five longer Parklands routes</h3>
              <ul>
                <li><a href="/rivers/floyds-fork-north-beckley-fisherville/">North Beckley to Fisherville</a> · 6.4 mi</li>
                <li><a href="/rivers/floyds-fork-north-beckley-cane-run/">North Beckley to Cane Run</a> · 10.7 mi</li>
                <li><a href="/rivers/floyds-fork-north-beckley-seaton-valley/">North Beckley to Seaton Valley</a> · 13.7 mi</li>
                <li><a href="/rivers/floyds-fork-north-beckley-broad-run-valley/">North Beckley to Broad Run Valley</a> · 17.2 mi</li>
                <li><a href="/rivers/floyds-fork-north-beckley-cliffside/">North Beckley to Cliffside</a> · 19.7 mi</li>
              </ul>
            </article>
            <article class="river-hub-context__item">
              <h3>Other extended choices</h3>
              <ul>
                <li><a href="/rivers/floyds-fork-creekside-cliffside/">Creekside to Cliffside</a> · extended lower-Parklands day trip</li>
                <li><a href="/rivers/floyds-fork-cane-run-broad-run-valley/">Cane Run to Broad Run Valley</a> · two access legs in one outing</li>
              </ul>
              <p>KDFWR lists a 50–300 cfs / 1.3–2.5 ft boating and fishing band at Fisherville; its education guide gives a broader 35–500 cfs recreation range. Treat these as source recommendations, not safety guarantees. The Parklands asks paddlers to use marked landings only and posts current access notices, including closures. Verify the selected trip's gauge, access, and shuttle before launch.</p>
            </article>
          </div>

          <p>
            Compare the current <a href="https://fw.ky.gov/Fish/Pages/floyds-fork.aspx" target="_blank" rel="noopener noreferrer">KDFWR access and level guide</a> with <a href="https://theparklands.org/app/uploads/2020/11/TheParklands_PaddlingMap_Public.pdf" target="_blank" rel="noopener noreferrer">The Parklands recommended-route map</a> and its <a href="https://theparklands.org/find-an-activity/paddling/" target="_blank" rel="noopener noreferrer">current paddling and access notices</a>. The sources differ slightly on some adjacent-leg mileages; each route guide keeps the source for its exact endpoints and distance.
          </p>
        </div>
      ) : null}

      {isTruckeeHub ? (
        <div class="river-hub-context__source-guide" aria-labelledby="truckee-river-sections-title">
          <div class="river-group-page__section-head">
            <div>
              <p class="eyebrow section-label">Nevada Trail Finder and local river maps</p>
              <h3 class="section-title" id="truckee-river-sections-title">Choose a Truckee River reach</h3>
            </div>
            <p class="muted river-group-page__section-note">
              Six documented sections keep focused guides. Every other endpoint pair stays selectable below.
            </p>
          </div>

          <div class="river-hub-context__grid">
            <article class="river-hub-context__item">
              <h3>Floriston–Verdi · technical whitewater</h3>
              <p>The roughly 10-mile Floriston I-80 launch to Crystal Peak Park run is a Class III–IV reach. It has a separate gauge at Farad; treat it as a technical trip with its own skill and flow requirements.</p>
              <a href={routeSlugHref('truckee-river-floriston-crystal-peak')}>Review Floriston to Crystal Peak Park</a>
            </article>
            <article class="river-hub-context__item">
              <h3>Reno–Sparks · public park access and diversion structures</h3>
              <ul>
                <li><a href={routeSlugHref('truckee-river-crystal-peak-mayberry')}>Crystal Peak Park to Mayberry Park</a> · about 8 mi</li>
                <li><a href={routeSlugHref('truckee-river-mayberry-cottonwood')}>Mayberry Park to Cottonwood Park</a> · about 10 mi</li>
                <li><a href={routeSlugHref('truckee-river-cottonwood-lockwood')}>Cottonwood Park to Lockwood Trailhead Park</a> · about 5 mi</li>
              </ul>
              <p>Downtown and Sparks routes can include diversion dams, portages, and engineered whitewater features. Check the notes for the exact start and take-out, and scout features before entering them.</p>
            </article>
            <article class="river-hub-context__item">
              <h3>Lower Truckee · Derby Dam and Wadsworth access</h3>
              <ul>
                <li><a href={routeSlugHref('truckee-river-lockwood-usa-parkway')}>Lockwood to USA Parkway</a> · about 12 mi</li>
                <li><a href={routeSlugHref('truckee-river-usa-parkway-wadsworth')}>USA Parkway to Wadsworth Bridge</a> · about 14.7 mi</li>
              </ul>
              <p>Portage left at historic Derby Dam. The Wadsworth Bridge take-out is on Pyramid Lake Paiute Tribal land; the Nevada map says a tribal boating permit is required for the USA Parkway–Wadsworth reach and that all river users must take out at Wadsworth Bridge.</p>
            </article>
          </div>

          <p>
            The <a href="https://files.aptuitivcdn.com/mVq57ky5p9-1707/docs/trails/map/TruckeeRiver11x17-10.1773313608.pdf" target="_blank" rel="noopener noreferrer">Nevada Truckee floatable-reaches map</a> identifies the upper, Reno–Sparks, and lower sections, dams, access points, and permit boundary. The Nevada Trail Finder page for Mayberry–Cottonwood currently lists 5.1 miles, while its map lists 10.8 miles and American Whitewater’s reach detail places Cottonwood Park 10.41 miles below Mayberry. This guide uses about 10 miles, supported by the reach map and detailed river feature distances, and flags the conflicting listing rather than hiding it.
          </p>
          <p>
            Use the gauge attached to each trip: <a href="https://waterdata.usgs.gov/monitoring-location/USGS-10346000/" target="_blank" rel="noopener noreferrer">Farad</a> for the upper run, <a href="https://waterdata.usgs.gov/monitoring-location/USGS-10348000/" target="_blank" rel="noopener noreferrer">Reno</a> for the central corridor, <a href="https://waterdata.usgs.gov/monitoring-location/USGS-10350000/" target="_blank" rel="noopener noreferrer">Vista</a> near the Lockwood–USA Parkway section, and <a href="https://waterdata.usgs.gov/monitoring-location/USGS-10351600/" target="_blank" rel="noopener noreferrer">below Derby Dam near Wadsworth</a> for the final reach. The Nevada map warns that higher flows make the runs more dangerous; a gauge reading alone does not clear hazards or authorize access.
          </p>
        </div>
      ) : null}

      {isSaukRiverHub ? (
        <div class="river-hub-context__source-guide" aria-labelledby="sauk-river-sections-title">
          <div class="river-group-page__section-head">
            <div>
              <p class="eyebrow section-label">Minnesota DNR State Water Trail</p>
              <h3 class="section-title" id="sauk-river-sections-title">Choose a Sauk River stretch</h3>
            </div>
            <p class="muted river-group-page__section-note">
              The two DNR map sections have different water and hazards. All 21 endpoint choices remain in the trip picker.
            </p>
          </div>

          <div class="river-hub-context__grid">
            <article class="river-hub-context__item">
              <h3>Map 1 · Sauk Centre to Spring Hill</h3>
              <p>The DNR recommends two day trips on this section. Both pass through open lowlands and tree-lined corridors; the Sauk Centre–Mill Pond run is a full-day 16.6-mile trip.</p>
              <ul>
                <li><a href={routeSlugHref('sauk-river-sauk-centre-dam-mill-pond')}>Sauk Centre Dam to Mill Pond</a> · 16.6 mi</li>
                <li><a href={routeSlugHref('sauk-river-oak-township-spring-hill')}>Oak Township to Spring Hill</a> · 10.8 mi</li>
              </ul>
              <p>Map 1 also notes that the river above Guernsey Lake is impassable most of the year from low water and that the Richmond area becomes a chain of lakes. These are distinct conditions from the lower river.</p>
            </article>

            <article class="river-hub-context__item">
              <h3>Map 2 · Spring Hill to the Mississippi</h3>
              <p>The DNR’s recommended Eagle Park–Miller Landing day trip is 8.6 river miles. It is not recommended in late summer when water is low, and thick vegetation can make the route difficult.</p>
              <ul>
                <li><a href={routeSlugHref('sauk-river-eagle-miller-landing')}>Eagle Park to Miller Landing</a> · 8.6 mi</li>
                <li><a href={routeSlugHref('sauk-river-frogtown-miller-landing')}>Frogtown to Miller Landing</a> · 14.2 mi; the DNR suggests starting at Frogtown to add about five miles</li>
              </ul>
              <p>Frogtown’s mapped landing is below Cold Spring Dam. Use the named downstream access and check current park rules before leaving a shuttle vehicle.</p>
            </article>

            <article class="river-hub-context__item">
              <h3>St. Cloud area · gauge and lower rapids</h3>
              <p>The DNR map describes nearly continuous Class I–II rapids in the final 2.5 miles when there is enough water. Routes ending at Heims Mill include that finish; routes ending at Miller Landing or Knights of Columbus stop upstream of it.</p>
              <ul>
                <li><a href={routeSlugHref('sauk-river-miller-landing-heims-mill')}>Miller Landing to Heims Mill</a> · 7.6 mi</li>
                <li><a href={routeSlugHref('sauk-river-pineview-heims-mill')}>Pineview Park to Heims Mill</a> · 6.2 mi</li>
              </ul>
              <p>The <a href="https://www.dnr.state.mn.us/waters/csg/site.html?id=16051001" target="_blank" rel="noopener noreferrer">DNR gauge near St. Martin</a> is useful context for nearby reaches. It does not describe the upper chain-of-lakes or certify conditions, wood clearance, or safety along every lower-river trip.</p>
            </article>

            <article class="river-hub-context__item">
              <h3>Spring Hill to St. Martin</h3>
              <p>This shorter upper-section option follows the mapped access corridor near the St. Martin gauge. The gauge can help with nearby water-level context, while vegetation, snags, access rules, and changing conditions still require a same-day check.</p>
              <a href={routeSlugHref('sauk-river-spring-hill-st-martin')}>Review Spring Hill to St. Martin · about 9.1 river mi</a>
            </article>
          </div>

          <p>
            Review the Minnesota DNR’s <a href="https://www.dnr.state.mn.us/state-water-trails/sauk-river/segments-maps.html" target="_blank" rel="noopener noreferrer">Sauk River segment descriptions</a>, <a href="https://files.dnr.state.mn.us/maps/canoe_routes/sauk1.pdf" target="_blank" rel="noopener noreferrer">Map 1</a>, and <a href="https://files.dnr.state.mn.us/maps/canoe_routes/sauk2.pdf" target="_blank" rel="noopener noreferrer">Map 2</a> before choosing a route. The DNR maps identify dams and portages, and note that snags may tip paddlers. Check current levels, weather, access, and the exact take-out before launch; a recommended section or gauge reading is not a safety guarantee.
          </p>
        </div>
      ) : null}

      {group.riverId === 'woonasquatucket-river-rhode-island' ? (
        <div class="river-hub-context__source-guide" aria-labelledby="woonasquatucket-providence-access-title">
          <div class="river-group-page__section-head">
            <div>
              <p class="eyebrow section-label">Providence paddle access</p>
              <h3 class="section-title" id="woonasquatucket-providence-access-title">Separate the new Kinsley launch from the listed route endpoints</h3>
            </div>
            <p class="muted river-group-page__section-note">
              WRWC documented the launch in 2026; confirm tide, event closures, and current access before choosing a lower-river trip.
            </p>
          </div>

          <p>
            The Woonasquatucket River Watershed Council says the Kinsley Avenue Boat Launch beside Farm Fresh Rhode Island opened with the Kinsley Avenue and Promenade Street Greenway project. WRWC's first documented downtown paddle from that launch went toward downtown on a rising tide. Those updates do not specify a fixed take-out or route distance, so use Kinsley as a current access reference rather than assuming it is an endpoint on one of the catalog routes below.
          </p>

          <div class="river-hub-context__grid">
            <article class="river-hub-context__item">
              <h3>Riverside Park to Waterplace Park · about 2.3 mi</h3>
              <p>WRWC confirms a canoe and kayak launch at Riverside Park and describes Waterplace Park as about 2.3 river miles away. The route page keeps that separate, fixed endpoint pair.</p>
              <a href="/rivers/woonasquatucket-river-riverside-waterplace/">Review Riverside Park to Waterplace Park</a>
            </article>
            <article class="river-hub-context__item">
              <h3>Waterplace Park to South Water Street</h3>
              <p>This listed route continues to the tidal landing. Check the tide, downtown event closures, boat traffic, and current water-quality notices before using it as a take-out.</p>
              <a href="/rivers/woonasquatucket-river-waterplace-south-water/">Review Waterplace Park to South Water Street</a>
            </article>
