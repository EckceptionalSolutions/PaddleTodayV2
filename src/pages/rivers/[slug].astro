                    ) : null}
                  </div>
                </details>
              ) : null}
              <a href="/terms/" class="river-link river-link--inline">Read Terms and Safety</a>
            </aside>

            <a
              class="route-overview-source"
              href={river.profile.thresholdSource.url}
              target="_blank"
              rel="noreferrer"
