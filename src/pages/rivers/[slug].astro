---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RouteTripPlan from '../../components/RouteTripPlan.astro';
import PaddlePlanningGuide from '../../components/PaddlePlanningGuide.astro';
import { priorityRouteGuides } from '../../data/priority-paddle-guides';
import { routeGeometryReviewHolds } from '../../lib/route-geometry-review-holds.js';
import RouteAppHandoff from '../../components/RouteAppHandoff.astro';
import { webFeatureFlags } from '../../lib/web-feature-flags';
import { accessMapHref, accessDirectionsHref, shuttleDirections, tripActionLinks } from '../../lib/trip-actions';

import FeatureIcon from '../../components/FeatureIcon.astro';
import GaugeBand from '../../components/GaugeBand.astro';
import RiverCameras from '../../components/RiverCameras.astro';
import RiverGaugeContext from '../../components/RiverGaugeContext.astro';
import WeatherDayStrip from '../../components/WeatherDayStrip.astro';
import LoadingFeedback from '../../components/LoadingFeedback.astro';
import { getRouteGalleryPhotos, getRoutePreviewPhoto } from '../../data/route-gallery';
import { getRouteSocialCard } from '../../data/route-social-cards';
import { FAVORITE_STAR_PATH } from '../../lib/favorites-icon.js';
import { listRivers } from '../../lib/rivers';
import { isIndexableRoutePage, routePageHref } from '../../data/route-page-consolidations';
import { gaugeDisplayForSource } from '../../lib/source-adapters';
import { evidenceNoteDetail, evidenceNoteLabel } from '../../lib/route-evidence';
import {
  buildRiverDetailLogisticsViewModel,
  buildRouteSafetyViewModel,
  buildSourceStrengthViewModel,
} from '@paddletoday/api-contract';

export function getStaticPaths() {
  return listRivers().map((river) => ({
    params: { slug: river.slug },
    props: { river },
  }));
}

const { river } = Astro.props;
const geometryReviewReason = routeGeometryReviewHolds.get(river.slug);
const planningGuide = priorityRouteGuides[river.slug];
const isPlanningRoute = river.scoreEligibility === 'planning';
const isLittleMiamiKelleyMilford = river.slug === 'little-miami-river-kelley-milford';
const gaugeDisplay = gaugeDisplayForSource(river.gaugeSource);
const thresholdConfidenceLabel = isPlanningRoute
  ? 'No published water-level range for this trip'
  : buildSourceStrengthViewModel(river.profile.thresholdSourceStrength).confidenceLabel;
const formatThresholdValue = (value: number | undefined) => {
  if (typeof value !== 'number') {
    return 'Water-level guidance unavailable';
  }

  if (river.gaugeSource.unit === 'cfs') {
    return `${Math.round(value).toLocaleString('en-US')} ${river.gaugeSource.unit}`;
  }

  return `${value.toFixed(2).replace(/\\.00$/, '')} ${river.gaugeSource.unit}`;
};
const isMinimumOnlyRoute = river.profile.thresholdModel === 'minimum-only';
const targetBandLabel = 'Preferred range';
const targetBandValue = isPlanningRoute
  ? 'No published range for this trip'
  : river.profile.thresholdModel === 'two-sided' &&
      typeof river.profile.idealMin === 'number' &&
      typeof river.profile.idealMax === 'number'
    ? `${formatThresholdValue(river.profile.idealMin)} to ${formatThresholdValue(river.profile.idealMax)}`
    : 'Needs paddler reports';
const minimumOnlyFloor = river.profile.tooLow ?? river.profile.idealMin;
const hasMinimumOnlyFloor = Number.isFinite(minimumOnlyFloor)
  && (river.gaugeSource.unit !== 'cfs' || (minimumOnlyFloor ?? 0) > 0);
const lowThresholdValue = isPlanningRoute
  ? 'Not established for this trip'
  : isMinimumOnlyRoute && !hasMinimumOnlyFloor
    ? 'Not established for this trip'
    : formatThresholdValue(isMinimumOnlyRoute ? minimumOnlyFloor : river.profile.tooLow);
const highThresholdValue = isPlanningRoute ? 'Not established for this trip' : formatThresholdValue(river.profile.tooHigh);
const putIn = river.putIn;
const takeOut = river.takeOut;
const logistics = river.logistics;
const logisticsModel = buildRiverDetailLogisticsViewModel(logistics);
const safetyProfile = river.safetyProfile;
const safetyModel = buildRouteSafetyViewModel(safetyProfile);
const safetyLevel = safetyModel.riskLevel;
const safetySummary = safetyModel.summary;
const safetyNotes = safetyModel.notes;
const safetyHazards = safetyModel.hazards;
const criticalSafetyNote = safetyNotes[0] ?? null;
const supportingSafetyNotes = safetyNotes.slice(1);
const putInMapsUrl = accessMapHref(putIn);
const takeOutMapsUrl = accessMapHref(takeOut);
const { google: directionsGoogleUrl, apple: directionsAppleUrl } = shuttleDirections(putIn, takeOut);
const openStreetMapUrl = `https://www.openstreetmap.org/?mlat=${river.latitude}&mlon=${river.longitude}#map=11/${river.latitude}/${river.longitude}`;
const shuttleHeadline = logisticsModel.shuttleHeadline;
const typicalTimeHeadline = logistics?.estimatedPaddleTime?.split(/[;,]/)[0]?.trim() || 'Check route notes';
const permitsHeadline = logisticsModel.permitsHeadline;
const campingHeadline = logisticsModel.campingHeadline;
const seasonMonthLabels = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const seasonMonths = river.profile.seasonMonths ?? [];
const firstSeasonMonth = seasonMonths.length > 0 ? seasonMonthLabels[seasonMonths[0] - 1] : null;
const lastSeasonMonth = seasonMonths.length > 0 ? seasonMonthLabels[seasonMonths[seasonMonths.length - 1] - 1] : null;
const seasonHeadline =
  firstSeasonMonth && lastSeasonMonth
    ? firstSeasonMonth === lastSeasonMonth
      ? firstSeasonMonth
      : `${firstSeasonMonth}-${lastSeasonMonth}`
    : 'Check seasonal notes';
const primaryAccessCaveat = logisticsModel.primaryAccessCaveat;
const secondaryAccessCaveat = logisticsModel.secondaryAccessCaveat;
const reportChangeHref =
  `/request-river/#mode=update&routeName=${encodeURIComponent(`${river.name} - ${river.reach}`)}&state=${encodeURIComponent(river.state)}` +
  `${putIn?.name ? `&putIn=${encodeURIComponent(putIn.name)}` : ''}` +
  `${takeOut?.name ? `&takeOut=${encodeURIComponent(takeOut.name)}` : ''}` +
  `${river.profile.thresholdSource.url ? `&sources=${encodeURIComponent(river.profile.thresholdSource.url)}` : ''}` +
  `&notes=${encodeURIComponent(
    `River: ${river.name} - ${river.reach}\n\nI noticed this might need an update:\n- \n\nWhat changed or looked wrong:\n- \n`
  )}`;
const reportChangeEmail = `mailto:routes@paddletoday.com?subject=${encodeURIComponent(`River update: ${river.name} (${river.state})`)}&body=${encodeURIComponent(
  `River: ${river.name} - ${river.reach}\nState: ${river.state}\nPut-in: ${putIn?.name ?? 'N/A'}\nTake-out: ${takeOut?.name ?? 'N/A'}\n\nWhat might need an update:\n- \n`
)}`;
const hasAccessPlanner = (river.accessPoints?.length ?? 0) > 2;
const accessPlannerPointsJson = JSON.stringify(river.accessPoints ?? []);
const defaultAccessPoints = river.accessPoints ?? [];
const defaultAccessPutIn = defaultAccessPoints[0];
const defaultAccessTakeOut = defaultAccessPoints[defaultAccessPoints.length - 1];
const defaultAccessRawDistance =
  defaultAccessPutIn && defaultAccessTakeOut
    ? defaultAccessTakeOut.mileFromStart - defaultAccessPutIn.mileFromStart
    : Number.NaN;
const defaultAccessDistance = Number.isFinite(defaultAccessRawDistance)
  ? Math.max(0.1, Number(defaultAccessRawDistance.toFixed(1)))
  : null;
const defaultAccessShape =
  defaultAccessPutIn?.segmentKind === 'lake' && defaultAccessTakeOut?.segmentKind === 'lake'
    ? 'Lake chain'
    : defaultAccessPutIn?.segmentKind === 'creek' && defaultAccessTakeOut?.segmentKind === 'creek'
      ? 'Creek-focused'
      : defaultAccessPutIn && defaultAccessTakeOut
        ? 'Mixed access'
        : 'Check route details';
const defaultAccessSummary =
  defaultAccessPutIn && defaultAccessTakeOut && defaultAccessDistance !== null
    ? `${defaultAccessPutIn.name} to ${defaultAccessTakeOut.name} is about ${defaultAccessDistance.toFixed(1)} mi. Use the planner to compare shorter access pairs.`
    : 'Select a put-in and take-out to compare shorter access pairs.';
const allRoutes = listRivers();
const siblingRoutes = allRoutes
  .filter((candidate) => candidate.riverId === river.riverId && candidate.slug !== river.slug)
  .sort((left, right) => left.reach.localeCompare(right.reach));
const riverHubHref = siblingRoutes.length > 0 ? `/rivers/by-river/${river.riverId}/` : null;
const distanceMiles = (left: typeof river, right: typeof river) => {
  const earthRadiusMiles = 3958.8;
  const toRadians = (degrees: number) => (degrees * Math.PI) / 180;
  const latDelta = toRadians(right.latitude - left.latitude);
  const lonDelta = toRadians(right.longitude - left.longitude);
  const leftLat = toRadians(left.latitude);
  const rightLat = toRadians(right.latitude);
  const haversine =
    Math.sin(latDelta / 2) ** 2 +
    Math.cos(leftLat) * Math.cos(rightLat) * Math.sin(lonDelta / 2) ** 2;

  return 2 * earthRadiusMiles * Math.asin(Math.sqrt(haversine));
};
const nearbyRouteRadiusMiles = 75;
const formatDifficulty = (difficulty: string | undefined) => {
  if (!difficulty) {
    return null;
  }

  return difficulty.charAt(0).toUpperCase() + difficulty.slice(1);
};
const routeLengthLabel = (candidate: typeof river) => candidate.logistics?.distanceLabel ?? null;
const routeInfoParts = (candidate: typeof river) =>
  [formatDifficulty(candidate.profile.difficulty), routeLengthLabel(candidate)].filter(Boolean);
const nearbyRoutes = allRoutes
  .filter((candidate) => candidate.slug !== river.slug && candidate.riverId !== river.riverId)
  .map((candidate) => ({
    ...candidate,
    distance: distanceMiles(river, candidate),
  }))
  .filter((candidate) => candidate.distance <= nearbyRouteRadiusMiles)
  .sort((left, right) => left.distance - right.distance)
  .slice(0, 4);
const hasSameRiverRoutes = siblingRoutes.length > 0;
const hasNearbyRoutes = nearbyRoutes.length > 0;
const routeDiscoveryGridClass =
  hasSameRiverRoutes && hasNearbyRoutes ? 'route-discovery__grid' : 'route-discovery__grid route-discovery__grid--single';
const siteUrl = Astro.site?.href ?? 'https://paddletoday.com/';
const homeUrl = new URL('/', siteUrl).href;
const routeUrl = new URL(`/rivers/${river.slug}/`, siteUrl).href;
const tripActions = tripActionLinks(river);
const tripGpxHref = tripActions.gpx;
const tripIcsHref = tripActions.calendar;
const riverHubUrl = riverHubHref ? new URL(riverHubHref, siteUrl).href : null;
const routeSeoTitle =
  river.seoTitle ??
  (isPlanningRoute
    ? `${river.name}: ${river.reach}, ${river.state} | Paddle Route`
    : `${river.name}: ${river.reach}, ${river.state} | Paddle Conditions`);
const seoDescriptionSuffix = isPlanningRoute
  ? ' Planning only; verify water and access.'
  : ' Check current water, weather, and access.';
const seoDescriptionCoreLimit = 155 - seoDescriptionSuffix.length;
const normalizedRouteSummary = (river.summary || '').replace(/\s+/g, ' ').trim();
const routeSummaryExcerpt = (() => {
  if (!normalizedRouteSummary) return '';
  if (normalizedRouteSummary.length <= seoDescriptionCoreLimit) return normalizedRouteSummary;

  const excerpt = normalizedRouteSummary.slice(0, seoDescriptionCoreLimit - 1);
  const lastSentenceBoundary = [...excerpt.matchAll(/(?<!\b[A-Z])[.!?](?=\s+[A-Z]|$)/g)].at(-1)?.index;
  if (
    lastSentenceBoundary !== undefined &&
    lastSentenceBoundary + 1 >= seoDescriptionCoreLimit * 0.65
  ) {
    return excerpt.slice(0, lastSentenceBoundary + 1).trimEnd();
  }

  const lastWordBoundary = excerpt.lastIndexOf(' ');
  const end = lastWordBoundary >= seoDescriptionCoreLimit * 0.65 ? lastWordBoundary : excerpt.length;
  return `${excerpt.slice(0, end).trimEnd().replace(/[.!?;:,]+$/, '')}…`;
})();
const routeSeoDescription =
  river.seoDescription ??
  (routeSummaryExcerpt
    ? `${routeSummaryExcerpt}${seoDescriptionSuffix}`
    : isPlanningRoute
      ? `Plan ${river.reach} on ${river.name} with route distance, difficulty, access details and source links. Planning only; no live route score.`
      : `Check today's paddle conditions for ${river.name}, including water level, weather, route distance, difficulty, and access details for ${river.reach}.`);
const routeIntro = isLittleMiamiKelleyMilford
  ? `This 4.9-mile route follows the Little Miami River from Kelley Nature Preserve to Jim Terrell Park near Milford, Ohio. It is listed as moderate and includes Class I–II features, low-head-dam remnants, strainers, and cold-water hazards.`
  : river.summary || `Plan ${river.reach} on ${river.name} in ${river.state}, with access details, gauge context, and route guidance.`;
const accessSafetyReviewValue = river.evidenceNotes.find(
  (note) => note.label.toLowerCase() === 'access and safety review',
)?.value;
const accessSafetyReviewDateLabel = (() => {
  if (!accessSafetyReviewValue || !/^\d{4}-\d{2}-\d{2}$/.test(accessSafetyReviewValue)) {
    return null;
  }

  const reviewDate = new Date(`${accessSafetyReviewValue}T00:00:00Z`);
  if (
    Number.isNaN(reviewDate.getTime()) ||
    reviewDate.toISOString().slice(0, 10) !== accessSafetyReviewValue
  ) {
    return null;
  }

  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(reviewDate);
})();

const routeShareTitle = `${river.name}: ${river.reach} | Paddle Today`;
const routeShareDescription = isPlanningRoute
  ? routeSeoDescription
  : `Check ${river.name} for ${river.reach}. Live gauge, weather, data reliability, access details, and today's paddle score before you drive.`;
const routeShareText = `Today's Paddle Today read for ${river.name} - ${river.reach}: live gauge, weather, data reliability, access, and a clear paddle call.`;
const routePreviewPhoto = getRoutePreviewPhoto(river);
const routePreviewLabel =
  routePreviewPhoto.sourceKind === 'route'
    ? 'Route photo'
    : routePreviewPhoto.sourceKind === 'river'
      ? 'River context'
      : 'Representative image';
const routePreviewCaption =
  routePreviewPhoto.sourceKind === 'route'
    ? routePreviewPhoto.caption
    : routePreviewPhoto.sourceKind === 'river'
      ? `${routePreviewPhoto.caption} — not necessarily this exact reach.`
      : 'Representative river image — not this exact route.';

const routeGalleryPhotos = getRouteGalleryPhotos(river).filter(photo => photo.src !== routePreviewPhoto.src);
const routeSocialCard = getRouteSocialCard(river.slug);
const routeShareCardHref = routeSocialCard?.src ?? '/brand/paddle-today-share-card-v3-1200x630.png';
const routeGalleryPhotosJson = JSON.stringify(routeGalleryPhotos);
const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Home',
    item: homeUrl,
  },
  ...(riverHubUrl
    ? [
        {
          '@type': 'ListItem',
          position: 2,
          name: river.name,
          item: riverHubUrl,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: `${river.name}: ${river.reach}`,
          item: routeUrl,
        },
      ]
    : [
        {
          '@type': 'ListItem',
          position: 2,
          name: `${river.name}: ${river.reach}`,
          item: routeUrl,
        },
      ]),
];
const routeStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${routeUrl}#breadcrumbs`,
  itemListElement: breadcrumbItems,
};
---

<BaseLayout
  title={routeSeoTitle}
  noindex={!isIndexableRoutePage(river.slug)}
  description={routeSeoDescription}
  structuredData={[routeStructuredData]}
  socialTitle={routeShareTitle}
  socialDescription={routeShareDescription}
  socialImage={routeSocialCard?.src ?? '/brand/paddle-today-share-card-v3-1200x630.png'}
  socialImageAlt={routeSocialCard?.alt ?? 'Paddle Today route share preview'}
  socialImageWidth={routeSocialCard?.width ?? 1200}
  socialImageHeight={routeSocialCard?.height ?? 630}
  ogType="article"
  twitterCard="summary_large_image"
  bodyClass="page-route-detail"
>
  <RouteAppHandoff slug={river.slug} />

  <article
    class:list={["river-detail", "river-detail--refined", isPlanningRoute && "river-detail--planning"]}
    data-river-detail
    data-river-slug={river.slug}
    data-river-id={river.riverId}
    data-river-name={river.name}
    data-river-reach={river.reach}
    data-river-state={river.state}
    data-river-region={river.region}
    data-river-distance={river.logistics?.distanceLabel}
    data-river-paddle-time={river.logistics?.estimatedPaddleTime}
    data-route-score-eligibility={river.scoreEligibility ?? 'scored'}
    data-route-url={routeUrl}
    data-route-share-title={routeShareTitle}
    data-route-share-text={routeShareText}
    data-put-in-name={putIn?.name}
    data-put-in-id={tripActions.putInId}
    data-put-in-latitude={putIn?.latitude}
    data-put-in-longitude={putIn?.longitude}
    data-take-out-name={takeOut?.name}
    data-take-out-id={tripActions.takeOutId}
    data-take-out-latitude={takeOut?.latitude}
    data-take-out-longitude={takeOut?.longitude}
  >
    {riverHubHref ? (
      <p class="river-detail__group-link">
        <a href={riverHubHref}>See all {siblingRoutes.length + 1} routes on {river.name}</a>
      </p>
    ) : null}

    <div class="river-detail__layout">
      <nav class="river-detail__section-nav river-detail__section-nav--desktop" aria-label="River page chapters">
        <div class="river-detail__section-nav-inner">
          <p class="river-detail__section-nav-label">On this page</p>
          <a class="river-detail__section-link" href="#todays-score" data-detail-nav-link="today" data-detail-nav-target="todays-score">
            {isPlanningRoute ? 'Overview' : 'Today'}
          </a>
          <a class="river-detail__section-link" href="#route-overview" data-detail-nav-link="overview" data-detail-nav-target="route-overview">
            Route overview
          </a>
          <a class="river-detail__section-link" href="#conditions" data-detail-nav-link="conditions" data-detail-nav-target="conditions">
            Conditions
          </a>
          <a class="river-detail__section-link" href="#route-gallery" data-detail-nav-link="reports" data-detail-nav-target="route-gallery">
            Photos &amp; reports
          </a>
          <a class="river-detail__section-link" href={isPlanningRoute ? '#planning-sources' : '#why-this-call'} data-detail-nav-link="sources" data-detail-nav-target={isPlanningRoute ? 'planning-sources' : 'why-this-call'}>
            Sources &amp; methodology
          </a>
        </div>
      </nav>

      <div class="river-detail__content">
    <section class="river-detail__hero" id="todays-score" data-detail-section="todays-score" data-detail-nav-group="today">
      <div class="river-detail__hero-main">
        <div class="river-detail__hero-warning" data-live-warning-wrap hidden>
          <span class="pill pill--warning" data-field="live-warning" hidden></span>
        </div>

        <div class="river-detail__hero-top">
          <div class="river-detail__hero-title-block">
            <p class="eyebrow">{river.state} | {river.region}</p>
            <h1 class="river-detail__title">
              <span>{river.name}</span>
              <span class="river-detail__reach">{river.reach}</span>
            </h1>

            <p class="route-seo-intro">{isLittleMiamiKelleyMilford ? "A 4.9-mile Class I–II run from Kelley Nature Preserve to Jim Terrell Park in Milford. Review the dam-remnant hazards against your group’s skills." : routeIntro}</p>
            {accessSafetyReviewDateLabel ? (
              <p class="muted" style="margin: 0.55rem 0 0;">
                Access and safety sources last checked {accessSafetyReviewDateLabel}.
              </p>
            ) : null}
          </div>
        </div>

        <LoadingFeedback name="detail" label="Checking current river conditions…" waiting="Still fetching river conditions. Route information and access details remain available below." skeleton={false} />
        <div class="route-overview-primary">
          <div class="river-detail__hero-map-shell" data-detail-hero-map-shell>
            <div class="river-detail__hero-map-frame">
              <div class="river-detail__hero-map" data-detail-hero-map aria-label={`${river.name} route snapshot map`}></div>
              <div class="river-detail__hero-map-copy">
                <div>
                  <p class="river-detail__hero-map-label">Route location</p>
                  <p class="river-detail__hero-map-status muted" data-detail-hero-map-status data-skeleton role="status">
                    {isPlanningRoute ? 'Loading the route map.' : 'Loading the route snapshot. This usually takes a few seconds.'}
                  </p>
                </div>
                <a class="river-link river-link--inline" href="#route-access-map" data-detail-open-map>Open access map</a>
              </div>
            </div>
          </div>

          <section class="route-overview-trip-fit" aria-label="Trip facts">
            <div>
              <span>Distance</span>
              <strong data-overview-distance>{logistics?.distanceLabel ?? 'Check source'}</strong>
            </div>
            <div>
              <span>Difficulty</span>
              <strong>{isLittleMiamiKelleyMilford ? 'Class I–II' : formatDifficulty(river.profile.difficulty) ?? 'Check source'}</strong>
            </div>
            <div>
              <span>Typical time</span>
              <strong data-overview-time title={logistics?.estimatedPaddleTime}>{typicalTimeHeadline}</strong>
            </div>
            <div>
              <span>Shuttle</span>
              <strong>{shuttleHeadline}</strong>
            </div>
          </section>

        </div>

        <aside class="route-decision-rail" aria-label="Today's decision">
        <section class="route-decision-dashboard" aria-labelledby="route-decision-title">
          <div class="route-decision-dashboard__heading">
            <div>
              <p class="eyebrow">Paddle today?</p>
              <h2 id="route-decision-title">Today at a glance</h2>
              {!isPlanningRoute ? (
                <p class="route-decision-dashboard__live-meta" aria-label="Live Data updated">
                  <span>Live Data</span>
                  <span aria-hidden="true">·</span>
                  <time data-field="generated-at">Checking</time>
                </p>
              ) : null}
            </div>
            {!isPlanningRoute ? <span class="pill" data-field="decision">Checking live data</span> : null}
          </div>

          <div class="route-decision-dashboard__grid">
            {isPlanningRoute ? (
              <aside class="planning-status-card planning-status-card--overview" aria-label="Planning route status">
                <p class="planning-status-card__eyebrow">Planning route</p>
                <h2>No same-day score</h2>
                <p class="planning-status-card__summary">
                  Use this page for the route plan, access, and hazards. Verify local water before launching.
                </p>
                <a class="river-link river-link--inline" href="/about/#route-eligibility">Why some routes are planning only</a>
              </aside>
            ) : (
              <aside class="river-call-panel route-today-score" aria-label="Today's paddle score">
                <p class="eyebrow">Paddling conditions</p>
                <div class="river-call-panel__scoreline">
                  <div class="score-orb score-orb--featured" role="img" aria-label="Live score loading">
                    <span class="score-orb__score" data-field="score" data-skeleton>--</span>
                    <span class="score-orb__rating" data-field="rating" data-skeleton>Checking</span>
                  </div>
                </div>
                <div class="river-call-panel__statement">
                  <span data-field="decision-line" data-skeleton>Checking the latest gauge and weather.</span>
                </div>
                <details class="river-score-tooltip route-today-score__breakdown">
                  <summary class="river-score-tooltip__summary">
                    <span>Score breakdown</span>
                  </summary>
                  <div class="river-score-tooltip__panel">
                    <div class="river-detail__summary" data-field="explanation" data-skeleton>Checking supporting evidence.</div>
                    <p class="muted river-score-tooltip__intro" data-field="breakdown-summary">
                      Checking what's driving today's score.
                    </p>

                    <div class="river-score-tooltip__rows">
                      <article class="river-score-tooltip__row">
                        <span class="river-score-tooltip__label">River conditions</span>
                        <strong class="river-score-tooltip__value river-score-breakdown__row-value--positive" data-field="breakdown-river-quality">
                          Checking
                        </strong>
                      </article>
                      <article class="river-score-tooltip__row">
                        <span class="river-score-tooltip__label">Wind</span>
                        <strong class="river-score-tooltip__value" data-field="breakdown-wind-adjustment">Checking</strong>
                      </article>
                      <article class="river-score-tooltip__row">
                        <span class="river-score-tooltip__label">Temperature</span>
                        <strong class="river-score-tooltip__value" data-field="breakdown-temperature-adjustment">Checking</strong>
                      </article>
                      <article class="river-score-tooltip__row">
                        <span class="river-score-tooltip__label">Rain timing</span>
                        <strong class="river-score-tooltip__value" data-field="breakdown-rain-adjustment">Checking</strong>
                      </article>
                      <article class="river-score-tooltip__row" data-breakdown-other-group hidden>
                        <span class="river-score-tooltip__label">Other</span>
                        <strong class="river-score-tooltip__value" data-field="breakdown-comfort-adjustment">Checking</strong>
                      </article>
                    </div>

                    <div class="river-score-tooltip__caps" data-score-cap-wrap hidden>
                      <p class="river-score-tooltip__caps-label">What held today's score back</p>
                      <ul class="compact-list river-score-tooltip__caps-list" data-score-cap-reasons>
                        <li>Checking what held today's score back.</li>
