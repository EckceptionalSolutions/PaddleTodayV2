              <div class="route-photo-form__grid">
                <label>
                  Your name *
                  <input name="contributorName" maxlength="120" autocomplete="name" placeholder="Full name or paddling handle" data-route-report-name />
                </label>

                <label>
                  Your email *
                  <input
                    name="contributorEmail"
                    type="email"
                    maxlength="160"
                    autocomplete="email"
                    placeholder="you@example.com"
                    data-route-report-email
                  />
                </label>
              </div>

              <div class="route-photo-form__grid route-photo-form__grid--meta">
                <label>
                  Trip date
                  <input name="tripDate" type="date" data-route-report-date />
                </label>

                <label>
                  How did it feel?
                  <select name="tripSentiment" data-route-report-sentiment>
                    <option value="">Select one</option>
                    <option value="great">Great day</option>
                    <option value="good">Good but watchable</option>
                    <option value="mixed">Mixed</option>
                    <option value="rough">Rough / sketchy</option>
                  </select>
                </label>
              </div>

              <div class="route-photo-form__grid route-photo-form__grid--meta">
                <label>
                  Observed water level *
                  <select name="observedWaterLevel" data-route-report-water-level>
                    <option value="">Select one</option>
                    <option value="too-low">Too low</option>
                    <option value="low">Low but usable</option>
                    <option value="ideal">Ideal</option>
                    <option value="high">High</option>
                    <option value="unsafe">Unsafe</option>
                    <option value="unknown">Could not tell</option>
                  </select>
                </label>

                <label>
                  Trip outcome *
                  <select name="tripCompletion" data-route-report-completion>
                    <option value="">Select one</option>
                    <option value="completed">Completed</option>
                    <option value="shortened">Shortened</option>
                    <option value="aborted">Aborted after starting</option>
                    <option value="not-launched">Did not launch</option>
                  </select>
                </label>
              </div>

              <label>
                Overall verdict *
                <select name="overallVerdict" data-route-report-verdict>
                  <option value="">Select one</option>
                  <option value="excellent">Excellent</option>
                  <option value="good">Good</option>
                  <option value="fair">Fair</option>
                  <option value="poor">Poor</option>
                  <option value="unsafe">Unsafe</option>
                </select>
              </label>

              <label>
                Condition report
                <span class="request-form__hint">Share the level, pace, access, wood, and anything others should know.</span>
                <textarea
                  name="tripReport"
                  rows="5"
                  maxlength="1800"
                  placeholder="Example: Water was moving well, put-in parking was easy, one new strainer on river right about halfway down, and the take-out stairs were slick."
                  data-route-report-text
                ></textarea>
              </label>

              <label>
                Extra notes
                <span class="request-form__hint">Optional extra context.</span>
                <textarea
                  name="notes"
                  rows="4"
                  maxlength="1200"
                  placeholder="Example: We paddled it in just under three hours and the wood was easy to spot."
                  data-route-report-notes
                ></textarea>
              </label>

              <label>
                Photos
                <span class="request-form__hint">Optional. Add up to 4 images.</span>
                <input
                  type="file"
                  name="photos"
                  accept="image/jpeg,image/png,image/webp"
                  multiple
                  data-route-report-files
                />
              </label>

              <p class="muted route-photo-form__selection" data-route-report-selection>
                No files selected.
              </p>

              <label class="route-photo-form__checkbox">
                <input type="checkbox" name="rightsConfirmed" data-route-report-rights />
                <span>If you add photos, I took them or have clear permission to share them.</span>
              </label>

              <label class="route-photo-form__checkbox">
                <input type="checkbox" name="reviewConsent" data-route-report-consent />
                <span>It's okay to contact me if you need more detail before publishing.</span>
              </label>

              <label class="request-form__hp" aria-hidden="true">
                Leave this blank
                <input name="company" tabindex="-1" autocomplete="off" data-route-report-company />
              </label>

              <div class="request-form__actions">
                <button class="filter-chip request-form__submit" type="submit" data-route-report-submit>Send condition report</button>
              </div>

              <p class="muted request-form__status route-photo-form__status" data-route-report-status aria-live="polite"></p>
            </form>
          </section>
        </div>
      </div>
    </details>

    </section>

    {!isPlanningRoute && isMinimumOnlyRoute && hasMinimumOnlyFloor ? (
      <aside class="route-calibration-callout" aria-label="More level reports needed">
        <div>
          <p class="route-calibration-callout__kicker">More level reports needed</p>
          <h2>Only a low-water floor is known.</h2>
          <p>
            We can tell when this route is likely too low, but we do not yet have enough reports to define a best range. If you paddled it recently, send a condition report with how the level felt.
          </p>
        </div>
        <a
          class="river-link river-link--inline"
          href="#share-trip"
          data-route-report-cta
          data-analytics-event="Open condition report"
        >
          Report recent conditions
        </a>
      </aside>
    ) : null}

    <section class="river-detail__chapter-head river-detail__chapter-head--understand" aria-label={isPlanningRoute ? 'Planning sources chapter' : 'Score and sources chapter'}>
      <h2 class="river-detail__chapter-title">Sources and methodology</h2>
      <p class="muted river-detail__chapter-copy">{accessSafetyReviewDateLabel ? `Access and safety sources checked ${accessSafetyReviewDateLabel}.` : planningGuide ? `Guides and maps checked ${planningGuide.reviewedOn ?? '2026-10-19'}.` : 'Review source dates and published guidance below.'} We have not inspected this trip in person.</p>
    </section>

    <section
      class="river-detail__panel river-accordion-group"
      id={isPlanningRoute ? 'planning-sources' : 'why-this-call'}
      data-detail-section={isPlanningRoute ? 'planning-sources' : 'why-this-call'}
      data-detail-nav-group="sources"
    >
      {!isPlanningRoute ? <>
        <details class="river-accordion" data-confidence-explainer>
          <summary class="river-accordion__summary">
            <span>
              <span class="eyebrow section-label">Why this score</span>
              <strong>Data reliability: {` `}<span data-field="confidence-detail-label">checking</span></strong>
            </span>
          </summary>
          <div class="river-accordion__body">
    {!isPlanningRoute ? (
    <section class="status-banner status-banner--loading" data-detail-status-banner aria-live="polite">
      <div class="status-banner__eyebrow">Data status</div>
      <div class="status-banner__body">
        <strong data-detail-banner-title>Checking live inputs.</strong>
        <p class="muted" data-detail-banner-detail>
          Pulling the latest gauge and weather. Usually under 10 seconds.
        </p>
      </div>
      <div class="status-banner__grid" data-detail-reliability-grid>
        <article class="status-banner__item">
          <span class="status-banner__label">Gauge input</span>
          <strong data-field="reliability-gauge-title">Checking</strong>
          <p class="muted" data-field="reliability-gauge-detail">
            Waiting on the gauge read.
          </p>
        </article>
        <article class="status-banner__item">
          <span class="status-banner__label">Weather input</span>
          <strong data-field="reliability-weather-title">Checking</strong>
          <p class="muted" data-field="reliability-weather-detail">
            Waiting on weather.
          </p>
        </article>
        <article class="status-banner__item">
          <span class="status-banner__label">Next step</span>
          <strong data-field="reliability-action-title">Checking</strong>
          <p class="muted" data-field="reliability-action-detail">
            Waiting on enough data to give the next step.
          </p>
        </article>
      </div>
    </section>
    ) : null}

            <p class="muted confidence-detail__intro">
          This rating reflects whether the gauge measures this part of the river, whether published water-level guidance is available, and how recently the data was updated.
            </p>

          <div class="confidence-detail__groups">
            <section class="confidence-detail__group">
              <span class="eyebrow section-label">Why</span>
              <ul class="confidence-rationale" data-confidence-reasons>
              <li>Checking data sources and update times.</li>
              </ul>
            </section>

            <section class="confidence-detail__group" data-confidence-warnings-group hidden>
              <span class="eyebrow section-label">Watch for</span>
              <ul class="confidence-rationale confidence-rationale--warnings" data-confidence-warnings>
              <li>Checking evidence cautions.</li>
              </ul>
            </section>
          </div>
        </div>
      </details>

        <details class="river-accordion">
          <summary class="river-accordion__summary">
            <span>
              <span class="eyebrow section-label">Data behind the score</span>
              <strong>Water levels, published guidance and update times</strong>
            </span>
          </summary>
          <div class="river-accordion__body">
            <p class="muted confidence-detail__intro">
        These readings and published water-level limits help explain today’s score.
            </p>
          <table class="detail-table">
            <tbody>
              <tr>
                <td>Gauge site</td>
                <td>{river.gaugeSource.siteName}</td>
              </tr>
              <tr>
                <td data-field="primary-gauge-label">{gaugeDisplay.primaryMetricLabel}</td>
                <td data-field="gauge-now">Checking</td>
              </tr>
              <tr>
                <td data-field="secondary-gauge-label">{gaugeDisplay.secondaryMetricLabel ?? 'Secondary gauge metric'}</td>
                <td data-field="discharge-now">Checking</td>
              </tr>
              <tr>
                <td>24h trend</td>
                <td data-field="trend">Checking</td>
              </tr>
              <tr>
                <td>24h change</td>
                <td data-field="flow-change-24h">Checking</td>
              </tr>
              <tr>
                <td>Current band</td>
                <td data-field="flow-band">Checking</td>
              </tr>
              <tr>
                <td>Rain last 24h</td>
                <td data-field="recent-rain-24h">Checking</td>
              </tr>
              <tr>
                <td>Rain last 72h</td>
                <td data-field="recent-rain-72h">Checking</td>
              </tr>
              <tr>
                <td>Air temp</td>
                <td data-field="weather-air-temp">Checking</td>
              </tr>
              <tr>
                <td>Water temp</td>
                <td data-field="weather-water-temp">Checking</td>
              </tr>
              <tr>
                <td>Wind</td>
                <td data-field="weather-wind">Checking</td>
              </tr>
              <tr>
                <td>Gusts</td>
                <td data-field="weather-gusts">Checking</td>
              </tr>
              <tr>
                <td>Rain timing</td>
                <td data-field="weather-rain-risk">Checking</td>
              </tr>
              <tr>
                <td>{targetBandLabel}</td>
                <td>{targetBandValue}</td>
              </tr>
              <tr>
                <td>{isMinimumOnlyRoute && hasMinimumOnlyFloor ? 'Known low-water floor' : 'Low threshold'}</td>
                <td>{lowThresholdValue}</td>
              </tr>
              <tr>
                <td>High threshold</td>
                <td>{highThresholdValue}</td>
              </tr>
              <tr>
                <td>Evidence strength behind the range</td>
                <td>{thresholdConfidenceLabel}</td>
              </tr>
              <tr>
                <td>Gauge observed</td>
                <td data-field="observed-at">Checking</td>
              </tr>
                <tr>
                  <td>Paddle Today updated</td>
                  <td data-field="generated-at">Checking</td>
                </tr>
              <tr>
                <td>Main source behind this score</td>
                <td>{river.profile.thresholdSource.label}</td>
              </tr>
              <tr>
                <td>Gauge source</td>
                <td data-field="gauge-source">Checking</td>
              </tr>
              <tr>
                <td>Weather source</td>
                <td data-field="weather-source">Checking</td>
              </tr>
              <tr>
                <td>Rainfall source</td>
                <td data-field="rainfall-source">Checking</td>
              </tr>
            </tbody>
          </table>
        </div>
      </details>
      </> : null}

      <details class="river-accordion">
        <summary class="river-accordion__summary">
          <span>
            <span class="eyebrow section-label">Notes</span>
            <strong>Published evidence and verification notes</strong>
          </span>
        </summary>
        <div class="river-accordion__body">
          <p class="muted confidence-detail__intro">
        These notes cover the access details, route quirks, and source caveats most likely to matter once you get there.
          </p>
          <ul class="factor-list">
            {river.evidenceNotes.map((note) => (
              <li class="factor-item impact-neutral">
                <div class="factor-item__head">
                  <span class="factor-item__label">{evidenceNoteLabel(note)}</span>
                  <span class="factor-item__value">{note.value}</span>
                </div>
                {evidenceNoteDetail(note) ? (
                  <p class="muted" style="margin: 0.55rem 0 0;">{evidenceNoteDetail(note)}</p>
                ) : null}
                {note.sourceUrl && /^https?:\/\//i.test(note.sourceUrl) ? (
                  <p style="margin: 0.55rem 0 0;">
                    <a href={note.sourceUrl} target="_blank" rel="noreferrer">
                      Source
                    </a>
                  </p>
                ) : null}
              </li>
            ))}
          </ul>
        </div>
      </details>

        <details class="river-accordion">
          <summary class="river-accordion__summary">
            <span>
              <span class="eyebrow section-label">Verify it yourself</span>
          <strong>Check the source links</strong>
            </span>
          </summary>
        <div class="river-accordion__body">
          <p class="muted confidence-detail__intro">
        Use these links to double-check the gauge, route details, and access notes before you head out.
          </p>
          {isLittleMiamiKelleyMilford ? <p>The Milford gauge is an observation at its station; weather and outlooks are forecasts. Neither verifies current obstructions or access.</p> : null}
          <ul class="source-list">
            {river.sourceLinks.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noreferrer">{source.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </details>
    </section>

    {hasSameRiverRoutes || hasNearbyRoutes ? (
    <details class="river-detail__panel route-discovery" data-detail-section="related-routes" data-detail-nav-group="overview" aria-labelledby="related-routes-title">
      <summary id="related-routes-title">Other routes nearby</summary>
      <div class={routeDiscoveryGridClass}>
        {hasSameRiverRoutes ? (
          <section class="route-discovery__group" aria-labelledby="same-river-routes-title">
            <div class="route-discovery__group-head">
              <h3 id="same-river-routes-title">More on {river.name}</h3>
              {riverHubHref ? <a href={riverHubHref}>All {siblingRoutes.length + 1}</a> : null}
            </div>
            <div class="route-discovery__list">
              {siblingRoutes.slice(0, 1).map((candidate) => (
                <a
                  class="route-discovery__link"
                  href={routePageHref(candidate.slug)}
                  data-analytics-event="Open related route"
                  data-analytics-label="same-river"
                >
                  <span class="route-discovery__route">{candidate.reach}</span>
                  <span class="route-discovery__meta">{candidate.region}</span>
                  {routeInfoParts(candidate).length > 0 ? (
                    <span class="route-discovery__facts">{routeInfoParts(candidate).join(' · ')}</span>
                  ) : null}
                  <span class="route-discovery__cta" aria-hidden="true">View route</span>
                </a>
              ))}
            </div>
          </section>
        ) : null}

        {hasNearbyRoutes ? (
          <section class="route-discovery__group" aria-labelledby="nearby-routes-title">
            <div class="route-discovery__group-head">
              <h3 id="nearby-routes-title">Nearby routes within {nearbyRouteRadiusMiles} miles</h3>
            </div>
            <div class="route-discovery__list">
              {nearbyRoutes.slice(0, 1).map((candidate) => (
                <a
                  class="route-discovery__link"
                  href={routePageHref(candidate.slug)}
                  data-analytics-event="Open related route"
                  data-analytics-label="nearby"
                >
                  <span class="route-discovery__route">{candidate.name}</span>
                  <span class="route-discovery__meta">
                    {candidate.reach} · about {Math.round(candidate.distance)} straight-line mi away
                  </span>
                  {routeInfoParts(candidate).length > 0 ? (
                    <span class="route-discovery__facts">{routeInfoParts(candidate).join(' · ')}</span>
                  ) : null}
                  <span class="route-discovery__cta" aria-hidden="true">View route</span>
                </a>
              ))}
            </div>
          </section>
        ) : null}
      </div>
    </details>
    ) : null}

    <section class="river-detail__panel river-report-panel" data-detail-section="flag-change" data-detail-nav-group="reports">
      <p class="eyebrow section-label">
        <FeatureIcon name="compass" size={16} />
        Flag a change
      </p>
      <div class="river-report-panel__content">
        <div>
          <h2 class="river-subtitle river-subtitle--compact">See something outdated?</h2>
          <p class="muted">
            Access, hazards, wood, and shuttle details change. Send a quick correction if something looks off.
          </p>
        </div>
        <div class="detail-map__links">
          <a
            class="river-link river-link--inline"
            href={reportChangeHref}
            data-analytics-event="Open route update"
          >
            Report a change
          </a>
          <a
            class="river-link river-link--inline"
            href={reportChangeEmail}
            data-analytics-event="Open route update email"
          >
            Email update
          </a>
        </div>
      </div>
    </section>
      </div>
    </div>
    <script>
      import '../../scripts/river-detail-page.js';
    </script>
  </article>
</BaseLayout>
