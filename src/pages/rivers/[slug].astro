                        <dt>Trend</dt>
                        <dd><span data-field="trend">Checking</span> · <span data-field="flow-change-24h">Checking 24h</span></dd>
                      </div>
                      <div>
                        <dt>Observed</dt>
                        <dd data-field="observed-at">Checking</dd>
