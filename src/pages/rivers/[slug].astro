                  Copy coordinates
                </button>
              ) : null}

            </div>
            <p class="muted" data-field="active-takeout-note">{secondaryAccessCaveat}</p>
          </article>
        </div>

        <h3 class="river-subtitle">Road shuttle</h3>
        {logistics?.shuttle ? <p class="muted" data-shuttle-instructions>{logistics.shuttle}</p> : null}
          <div class="detail-map__links detail-map__links--primary">
            {directionsGoogleUrl ? (
