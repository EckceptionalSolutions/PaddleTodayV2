        <article class="snapshot-card snapshot-card--with-icon">
          <span class="snapshot-card__icon"><FeatureIcon name="clock" size={18} /></span>
          <span class="snapshot-card__label">Season</span>
          <strong>{seasonHeadline}</strong>
          <small>{river.profile.seasonNotes}</small>
        </article>
      </div>
      </details>
    </section>

    <section class="river-detail__panel river-launch-plan" id="access-plan" data-detail-section="access-plan" data-detail-nav-group="overview">
