              {accessDirectionsHref(takeOut) && <a class="river-link river-link--inline river-link--primary" href={accessDirectionsHref(takeOut)} target="_blank" rel="noreferrer" data-access-takeout-directions aria-label="Directions to take-out">Directions</a>}
              {takeOutMapsUrl ? (
                <a
                  class="river-link river-link--inline river-access-card__map-link"
