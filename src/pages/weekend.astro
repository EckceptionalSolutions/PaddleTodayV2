---
import BaseLayout from '../layouts/BaseLayout.astro';
import RouteBoardCardTemplate from '../components/RouteBoardCardTemplate.astro';
import SummaryMapPanel from '../components/SummaryMapPanel.astro';

const siteUrl = Astro.site?.href ?? 'https://paddletoday.com/';
const weekendUrl = new URL('/weekend/', siteUrl).href;
const organizationId = new URL('/#organization', siteUrl).href;
const websiteId = new URL('/#website', siteUrl).href;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${weekendUrl}#collection`,
    name: 'Best Picks This Weekend',
    description: 'Plan ahead with Paddle Today weekend river picks built from current river shape and the latest forecast confidence.',
    url: weekendUrl,
    isPartOf: {
      '@id': websiteId,
    },
    about: {
      '@id': organizationId,
    },
  },
];
---

<BaseLayout
  title="Paddle Today | Best Picks This Weekend"
  description="Plan ahead with Paddle Today weekend river picks built from current river shape and the latest forecast confidence."
  structuredData={structuredData}
>
  <section class="decision-hero hero weekend-hero">
    <div class="decision-hero__intro">
      <p class="hero__kicker">Weekend planning</p>
      <h1>Best picks this weekend</h1>
      <p class="hero__dates" data-weekend-dates>
        Saturday and Sunday dates are loading.
      </p>
      <p class="hero__lede">
        Early read from current river shape and the weekend forecast. Re-check before you commit to the drive.
      </p>
      <p class="hero__snapshot" data-weekend-snapshot>
        Checking weekend outlooks...
      </p>
    </div>

    <aside class="hero-call decision-hero__featured weekend-hero__featured" aria-live="polite">
      <p class="eyebrow" data-weekend-featured-label>Top weekend pick</p>
      <p class="hero-call__state" data-weekend-featured-state>Loading weekend read.</p>
      <h2 class="hero-call__title" data-weekend-featured-name>Checking the board</h2>
      <p class="hero-call__reach" data-weekend-featured-reach>Weekend forecast confidence is loading.</p>
      <p class="hero-call__verdict" data-weekend-featured-verdict>Checking outlook</p>

      <div class="hero-call__scoreline">
        <div class="score-orb score-orb--featured" aria-label="Weekend score">
          <span class="score-orb__score" data-weekend-featured-score>--</span>
          <span class="score-orb__rating" data-weekend-featured-rating>Loading</span>
        </div>

        <div class="hero-call__score-meta">
          <div class="weekend-featured__weather" data-weekend-featured-weather hidden></div>
          <p class="hero-call__signal-line" data-weekend-featured-signal>Loading forecast signals</p>
        </div>
      </div>

      <p class="hero-call__reason" data-weekend-featured-reason>Loading summary</p>
      <ul class="hero-call__reasons" data-weekend-featured-reasons></ul>

      <figure class="weekend-featured__gallery route-photo-preview" data-weekend-featured-gallery hidden>
        <img
          class="weekend-featured__gallery-image route-photo-preview__image"
          data-weekend-featured-gallery-image
          alt=""
          loading="lazy"
        />
        <span class="route-photo-preview__badge" data-weekend-featured-gallery-placeholder hidden>
          Placeholder
        </span>
        <a
          class="route-photo-preview__contribute"
          href="/contribute/"
          data-weekend-featured-gallery-contribute
          data-analytics-event="Open photo contribution"
        >
          <span aria-hidden="true">+</span>
          Contribute Photos
        </a>
      </figure>

      <p class="hero-call__summary muted" data-weekend-featured-explanation>
        Pulling the strongest weekend pick from the latest stored snapshot.
      </p>
      <button class="hero-call__toggle" type="button" data-weekend-featured-toggle hidden aria-expanded="false">
        Details
      </button>

      <section class="weekend-featured__facts river-card__facts-section" data-weekend-featured-facts-section hidden>
        <p class="river-card__facts-label">Route facts</p>
        <div class="river-card__facts" data-weekend-featured-facts></div>
      </section>

      <div class="decision-hero__actions">
        <a class="river-link river-link--inline" href="/" data-weekend-featured-link>View route</a>
      </div>
    </aside>

    <div class="decision-hero__support">
      <p class="hero__overview-label">Weekend overview</p>
      <ul class="hero__call-mix" data-weekend-call-mix>
        <li class="hero__call-mix-item hero__call-mix-item--good">
          <strong data-weekend-strong-count>--</strong>
          <span>Strong</span>
        </li>
        <li class="hero__call-mix-item hero__call-mix-item--mixed">
          <strong data-weekend-good-count>--</strong>
          <span>Good</span>
        </li>
        <li class="hero__call-mix-item hero__call-mix-item--mixed">
          <strong data-weekend-fair-count>--</strong>
          <span>Fair: tradeoffs</span>
        </li>
        <li class="hero__call-mix-item hero__call-mix-item--no-go">
          <strong data-weekend-withheld-count>--</strong>
          <span>Not enough data</span>
        </li>
      </ul>
      <p class="hero__project-label">Planning note</p>
      <p class="hero__note muted">
        “Not enough data” means the weekend score was withheld because the forecast, live river read,
        working-range calibration, or confidence was not strong enough.
      </p>
    </div>
  </section>

  <section class="weekend-planner" aria-labelledby="weekend-planner-title">
    <div class="weekend-planner__head">
      <div>
        <p class="eyebrow">Plan around the drive</p>
        <h2 class="section-title" id="weekend-planner-title">Filter weekend routes</h2>
      </div>
      <p class="muted weekend-planner__summary" data-weekend-filter-summary>
        Add your location to sort by drive time and set a weekend range.
      </p>
    </div>

    <div class="weekend-location-strip" data-weekend-location-strip>
      <div class="weekend-location-strip__copy">
        <p class="weekend-location-strip__label" data-weekend-location-label>Plan from your location</p>
        <p class="muted weekend-location-strip__hint" data-weekend-location-hint>
          Use your location to include drive time in the weekend ranking.
        </p>
      </div>
      <div class="weekend-location-strip__actions">
        <button class="filter-chip filter-chip--primary" type="button" data-weekend-location-use>
          Use my location
        </button>
        <button class="filter-chip filter-chip--quiet" type="button" data-weekend-location-clear hidden>
          Clear
        </button>
      </div>
    </div>

    <div class="weekend-distance" data-weekend-distance hidden>
      <p class="weekend-planner__control-label">Weekend range</p>
      <div class="weekend-distance__options" role="group" aria-label="Weekend driving range">
        <button class="filter-chip filter-chip--subtle" type="button" data-weekend-distance-option="100">100 mi</button>
        <button class="filter-chip filter-chip--subtle" type="button" data-weekend-distance-option="200">200 mi</button>
        <button class="filter-chip filter-chip--subtle" type="button" data-weekend-distance-option="300">300 mi</button>
        <button class="filter-chip filter-chip--subtle" type="button" data-weekend-distance-option="500">500 mi</button>
        <button class="filter-chip filter-chip--subtle" type="button" data-weekend-distance-option="any">Any</button>
      </div>
    </div>

    <div class="weekend-plan-lanes-wrap">
      <p class="weekend-planner__control-label">Route type</p>
      <div class="weekend-plan-lanes" role="group" aria-label="Weekend route type">
        <button class="weekend-plan-lane" type="button" data-weekend-filter="all" aria-pressed="true">
          <strong data-weekend-filter-count="all">0</strong>
          <span>All routes</span>
          <small>Full weekend board</small>
        </button>
        <button class="weekend-plan-lane" type="button" data-weekend-filter="day-trips" aria-pressed="false">
          <strong data-weekend-filter-count="day-trips">0</strong>
          <span>Day trips</span>
          <small>Good calls first</small>
        </button>
        <button class="weekend-plan-lane" type="button" data-weekend-filter="camping" aria-pressed="false">
          <strong data-weekend-filter-count="camping">0</strong>
          <span>Camping</span>
          <small>Camp support noted</small>
        </button>
        <button class="weekend-plan-lane" type="button" data-weekend-filter="rechecks" aria-pressed="false">
          <strong data-weekend-filter-count="rechecks">0</strong>
          <span>Rechecks</span>
          <small>Fair routes to watch</small>
        </button>
      </div>
    </div>
  </section>

  <div class="weekend-page__map-wrap" data-weekend-map-section hidden>
    <SummaryMapPanel
      id="weekend-routes-map"
      className="weekend-page__map"
      eyebrow="Weekend map"
      title="Weekend routes on the map"
      lede="The map follows your driving range and route type. Select a score to open that route."
      showResults={false}
      status="Loading weekend routes."
      ariaLabel="Filtered weekend paddle routes"
      showNoGoLegend={false}
    >
      <div class="weekend-map-empty" slot="map-overlay" data-weekend-map-empty role="status" hidden>
        <div class="weekend-map-empty__card">
          <p class="eyebrow">Nothing in this view</p>
          <h3 data-weekend-map-empty-title>No routes match this filter</h3>
          <p class="muted" data-weekend-map-empty-copy>
            Try another route type or widen your weekend range.
          </p>
          <button class="river-link river-link--inline" type="button" data-weekend-map-empty-reset>
            Show all routes
          </button>
        </div>
      </div>
    </SummaryMapPanel>
  </div>

  <section class="home-board-inline home-board-inline--wide guide-link-strip" aria-label="Weekend paddling guide">
    <p class="home-board-inline__copy">Planning a Minnesota weekend paddle?</p>
    <a class="river-link river-link--inline river-link--ghost" href="/guides/best-minnesota-paddle-trips/">
      View Minnesota paddle trip guide
    </a>
  </section>

  <section class="decision-section decision-section--recommended weekend-page__section" data-weekend-primary-section>
    <div class="section-head section-head--stacked">
      <div>
        <p class="eyebrow">Weekend shortlist</p>
        <h2 class="section-title" data-weekend-primary-title>Top weekend picks</h2>
      </div>
      <p class="muted section-head__note" data-weekend-primary-note>
        Use this as a planning read for Saturday and Sunday, then check again before you drive.
      </p>
    </div>

    <div class="recommendation-grid weekend-page__grid" data-weekend-grid></div>
    <div class="weekend-empty-state decision-section__empty" data-weekend-empty hidden>
      <p class="weekend-empty-state__title" data-weekend-empty-title>No reliable weekend picks yet</p>
      <p class="muted weekend-empty-state__copy" data-weekend-empty-copy>
        Forecast confidence is still too low to make weekend calls.
      </p>
    </div>
  </section>

  <section class="decision-section weekend-page__section" data-weekend-camping-section hidden>
    <div class="section-head section-head--stacked">
      <div>
        <p class="eyebrow">Camping</p>
        <h2 class="section-title">Camping-friendly</h2>
      </div>
      <p class="muted section-head__note">
        Good weekend routes with camping nearby, at an access, or along the route.
      </p>
    </div>

    <div class="recommendation-grid weekend-page__grid" data-weekend-camping-grid></div>
    <div class="weekend-empty-state decision-section__empty" data-weekend-camping-empty hidden>
      <p class="weekend-empty-state__title">No camping-friendly picks in this range</p>
      <p class="muted weekend-empty-state__copy">
        Try a wider driving range or check all weekend routes.
      </p>
    </div>
  </section>

  <section class="decision-section weekend-page__section" data-weekend-watch-section hidden>
    <div class="section-head section-head--stacked">
      <div>
        <p class="eyebrow">Fair: tradeoffs</p>
        <h2 class="section-title">Re-check if the forecast improves</h2>
      </div>
      <p class="muted section-head__note">
        These routes might work, but they need a better forecast before they are worth planning around.
      </p>
    </div>

    <div class="recommendation-grid weekend-page__grid" data-weekend-watch-grid></div>
    <div class="weekend-empty-state decision-section__empty" data-weekend-watch-empty hidden>
      <p class="weekend-empty-state__title">No routes need a recheck right now</p>
      <p class="muted weekend-empty-state__copy">
        Fair routes will appear here when they are close enough to watch but not ready to recommend.
      </p>
    </div>
  </section>

  <RouteBoardCardTemplate />

  <script>
    import '../scripts/weekend-page.js';
  </script>
</BaseLayout>
