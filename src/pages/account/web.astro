---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WebAccountFeaturesPaused from '../../components/WebAccountFeaturesPaused.astro';
import { webFeatureFlags } from '../../lib/web-feature-flags';
---
<BaseLayout
  title={webFeatureFlags.webAccountExperience ? 'Welcome to PaddleToday' : 'PaddleToday'}
  noindex
  privatePage
  headerTitle={webFeatureFlags.webAccountExperience ? 'Welcome to PaddleToday' : 'Find the best paddle near you today'}
  headerBlurb={webFeatureFlags.webAccountExperience ? 'Your next paddle starts here.' : 'Live score, water level, and weather.'}
>
  <div class="trips-page">
    {webFeatureFlags.webAccountExperience ? <div id="trips-app" aria-busy="true"><p role="status">Completing sign-in…</p></div> : <WebAccountFeaturesPaused />}
  </div>
  {webFeatureFlags.webAccountExperience && <link rel="stylesheet" href="/styles/trips.css?v=20261006-account" />}
  <script>
    if (document.getElementById('trips-app')) await import('../../scripts/trips-page');
  </script>

</BaseLayout>
