---
import FeatureIcon from './FeatureIcon.astro';

const {
  id,
  mode = 'explore',
  className = '',
  mobileLayout = 'collapse',
  eyebrow = 'Score map',
  title,
  lede = '',
  showResults = true,
  resultsTitle = 'Shown on map',
  note = 'Loading routes.',
  status = 'Loading map.',
  ariaLabel = 'Route score map',
  itemNounSingular = 'river',
  itemNounPlural = 'rivers',
  showRiverLegend = false,
  interactiveScoreLegend = false,
} = Astro.props;

const shellClass = [mode === 'nearby' ? 'summary-map-shell summary-map-shell--nearby' : 'summary-map-shell', className]
  .filter(Boolean)
  .join(' ');

const scoreLegendItems = [
  { rating: 'Strong', score: '90', label: 'Strong', markerClass: 'summary-map-legend__marker--great', enabled: true },
  { rating: 'Good', score: '70', label: 'Good', markerClass: 'summary-map-legend__marker--good', enabled: true },
  { rating: 'Fair', score: '55', label: 'Fair: tradeoffs', markerClass: 'summary-map-legend__marker--marginal', enabled: true },
  { rating: 'No-go', score: '15', label: 'No-go', markerClass: 'score-map-marker--no-go score-map-marker--confidence-low', enabled: false },
];
---

<section
  class={shellClass}
  id={id}
  data-summary-map-shell
  data-summary-map-mode={mode}
  data-summary-map-mobile-layout={mobileLayout}
  data-summary-map-item-singular={itemNounSingular}
  data-summary-map-item-plural={itemNounPlural}
>
  {mobileLayout === 'list-map' && (
    <div class="summary-map-mobile-switch" data-summary-map-mobile-switch hidden>
      <button
        class="summary-map-mobile-switch__button"
        type="button"
        data-summary-map-mobile-view="list"
        aria-pressed="true"
      >
        <span class="summary-map-mobile-switch__label">List</span>
        <span class="summary-map-mobile-switch__count" data-summary-map-mobile-count="list">0</span>
      </button>
      <button
        class="summary-map-mobile-switch__button"
        type="button"
        data-summary-map-mobile-view="map"
        aria-pressed="false"
      >
        <span class="summary-map-mobile-switch__label">Map</span>
        <span class="summary-map-mobile-switch__count" data-summary-map-mobile-count="map">0</span>
      </button>
    </div>
  )}
  <div class="summary-map-copy">
    <div class="summary-map-copy__intro">
      <p class="eyebrow section-label">
        <FeatureIcon name="map" size={16} />
        {eyebrow}
      </p>
      <h2 class="section-title">{title}</h2>
      {lede && <p class="muted summary-map-copy__lede">{lede}</p>}
    </div>
    {showResults && (
      <div class="summary-map-results-panel" data-summary-map-results-panel>
        <div class="summary-map-results-head">
          <div class="summary-map-results-head__row">
            <p
              class="summary-map-results__title"
              data-summary-map-results-title
              data-default-label={resultsTitle}
              data-mobile-map-label="Map shortlist"
            >
              {resultsTitle}
            </p>
            <button
              class="filter-chip filter-chip--quiet summary-map-results__back"
              type="button"
              data-summary-map-mobile-back
              hidden
            >
              List
            </button>
          </div>
          <p class="muted summary-map-results__note" data-summary-map-results-note>{note}</p>
        </div>
        <div class="summary-map-results" data-summary-map-results aria-live="polite"></div>
      </div>
    )}
    <button class="filter-chip summary-map__toggle" type="button" data-summary-map-toggle hidden aria-expanded="true">Hide map</button>
  </div>

  <div class="summary-map-frame">
    <div class="summary-map" data-summary-map aria-label={ariaLabel}></div>
    <div class="summary-map-footer">
      <p class="summary-map__status muted" data-summary-map-status>{status}</p>
      <div class="summary-map-legend" aria-label="Map marker legend">
        {showRiverLegend && (
          <>
            <span class="summary-map-legend__item">
              <span class="summary-map-legend__line summary-map-legend__line--river"></span>
              Supported river
            </span>
            <span class="summary-map-legend__item">
              <span class="summary-map-legend__line summary-map-legend__line--reach"></span>
              Selected reach
            </span>
          </>
        )}
        {scoreLegendItems.map((item) => interactiveScoreLegend ? (
          <button
            class="summary-map-legend__item summary-map-legend__toggle"
            type="button"
            data-summary-score-toggle={item.rating}
            aria-pressed={item.enabled ? 'true' : 'false'}
          >
            <span class={`summary-map-legend__marker ${item.markerClass}`}>{item.score}</span>
            {item.label}
          </button>
        ) : (
          <span class="summary-map-legend__item">
            <span class={`summary-map-legend__marker ${item.markerClass}`}>{item.score}</span>
            {item.label}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
