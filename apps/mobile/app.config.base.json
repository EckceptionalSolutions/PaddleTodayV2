{
  "expo": {
    "name": "PaddleToday",
    "slug": "paddletoday-mobile",
    "version": "1.1.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "paddletoday",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4f1e8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paddletoday.mobile",
      "associatedDomains": [
        "applinks:paddletoday.com",
        "applinks:paddletoday-9933a.firebaseapp.com"
      ],
      "appStoreUrl": "https://apps.apple.com/app/id6769542734",
      "buildNumber": "37",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "PaddleToday can send route alerts and nearby paddling opportunities when conditions match your choices.",
        "NSPhotoLibraryUsageDescription": "PaddleToday lets you attach route photos when you choose to submit paddling reports.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#f4f1e8"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.paddletoday.mobile",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.paddletoday.mobile",
      "versionCode": 30,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "paddletoday.com",
              "pathPrefix": "/rivers/"
            },
            {
              "scheme": "https",
              "host": "paddletoday.com",
              "pathPrefix": "/trips"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "paddletoday.com",
              "pathPrefix": "/auth/callback"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "paddletoday-9933a.firebaseapp.com",
              "pathPrefix": "/__/auth/links"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PaddleToday uses your location to show nearby paddling options and to record a route only while you choose to record a paddle.",
          "locationAlwaysAndWhenInUsePermission": "PaddleToday records your route only during a paddle you start, including while your screen is locked. Recording stops when you pause or finish.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PaddleToday lets you choose photos for your private paddle recap or a route report."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAuth",
              "RNFBAnalytics",
              "RNFBCrashlytics"
            ]
          }
        }
      ],
      "./plugins/with-rnfirebase-ios-privacy",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f9349f7d-e977-4210-b6b4-e95029226ede"
      }
    },
    "owner": "eckceptionalsolutions"
  }
}
