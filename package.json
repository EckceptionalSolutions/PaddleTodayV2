{
  "name": "canoe-adventures-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api": "tsx src/server/api-server.ts --port 4322",
    "api:watch": "tsx watch src/server/api-server.ts --port 4322",
    "deps:graph": "node scripts/madge.mjs",
    "deps:unused": "node scripts/knip.mjs",
    "deps:check": "npm run deps:graph && npm run deps:unused",
    "dev": "astro dev",
    "predev": "npm run tokens:sync && npm run scripts:public:sync",
    "typecheck": "npm run tokens:check && npm run scripts:public:check && npm run dry:check && node scripts/typecheck.mjs",
    "typecheck:routes": "tsc --noEmit -p tsconfig.route-data.json",
    "routes:audit": "tsx scripts/audit-route-data.ts",
    "routes:audit:coordinates": "tsx scripts/audit-route-coordinate-river-distance.ts",
    "routes:audit:coordinates:visual": "tsx scripts/generate-route-coordinate-failure-review.ts",
    "routes:geometries:generate": "tsx scripts/generate-canonical-river-geometries.ts",
    "routes:geometries:audit": "tsx scripts/audit-canonical-river-geometries.ts",
    "routes:audit:overlap": "tsx scripts/audit-route-overlap.ts",
    "routes:audit:corridors": "tsx scripts/audit-route-corridors.ts",
    "routes:report:corridor-funnel": "tsx scripts/report-corridor-funnel.ts",
    "routes:audit:deprecations": "tsx scripts/audit-route-deprecations.ts",
    "photos:audit": "tsx scripts/audit-photo-coverage.ts",
    "gallery:audit": "node scripts/optimize-gallery-images.mjs",
    "gallery:optimize": "node scripts/optimize-gallery-images.mjs --write",
    "routes:leads:gather": "tsx scripts/gather-route-leads.ts",
    "routes:control:plan": "npm run routes:leads:gather && tsx scripts/route-control-plane.ts plan",
    "routes:control:claim": "npm run routes:leads:gather && tsx scripts/route-control-plane.ts claim",
    "routes:control:complete": "tsx scripts/route-control-plane.ts complete",
    "routes:control:queue": "tsx scripts/route-control-plane-queue.ts",
    "routes:control:ui": "tsx scripts/route-control-plane-ui.ts",
    "routes:data:split": "tsx scripts/split-route-data.ts",
    "routes:safety:audit": "tsx scripts/audit-route-safety.ts",
    "alert:mock-email": "tsx scripts/send-mock-river-alert.ts",
    "alert:mock-push": "tsx scripts/send-mock-river-push.ts",
    "prebuild": "npm run tokens:sync && npm run scripts:public:sync",
    "build": "npm run typecheck && astro build",
    "prebuild:app": "npm run tokens:sync && npm run scripts:public:sync",
    "build:app": "astro build",
    "preview": "npm run build && npm run serve",
    "preview:local": "npm run build && npm run serve:local",
    "serve": "tsx src/server/api-server.ts --static dist --port 4321",
    "serve:local": "tsx src/server/api-server.ts --static dist --port 4323",
    "history:snapshot": "tsx src/server/history-snapshot.ts",
    "snapshots:refresh": "tsx src/server/river-snapshot.ts",
    "alerts:evaluate": "tsx src/server/alerts-evaluate.ts",
    "alerts:reconcile-push": "tsx src/server/alerts-reconcile-push.ts",
    "start": "tsx src/server/api-server.ts --static dist",
    "test": "npm run typecheck && vitest run && npm run test --workspace @paddletoday/api-contract",
    "test:maps": "playwright test tests/visual/map-interactions.spec.ts --project=desktop-chromium --workers=1",
    "mobile:start": "npm run start --workspace @paddletoday/mobile",
    "mobile:android": "npm run android --workspace @paddletoday/mobile",
    "mobile:ios": "npm run ios --workspace @paddletoday/mobile",
    "postinstall": "node scripts/apply-react-native-android-drawing-order-fix.mjs",
    "mobile:typecheck": "npm run typecheck --workspace @paddletoday/mobile",
    "mobile:api-smoke": "node scripts/mobile-api-smoke.mjs",
    "cloudflare:traffic": "node scripts/cloudflare-traffic-summary.mjs",
    "metrics:daily": "tsx scripts/daily-site-metrics.ts",
    "metrics:weekly": "tsx scripts/weekly-product-report.ts",
    "mobile:generate-icons": "node scripts/generate-mobile-icons.mjs",
    "mobile:release-check": "node scripts/mobile-release-check.mjs",
    "mobile:eas:whoami": "npm run eas --workspace @paddletoday/mobile -- whoami",
    "mobile:ios:testflight": "npm run ios:testflight --workspace @paddletoday/mobile",
    "deployment:smoke": "node scripts/deployment-smoke.mjs",
    "rate-limit:smoke": "node scripts/rate-limit-smoke.mjs",
    "scripts:public:sync": "node scripts/sync-public-scripts.mjs",
    "scripts:public:check": "node scripts/sync-public-scripts.mjs --check",
    "tokens:sync": "node scripts/sync-design-tokens.mjs",
    "tokens:check": "node scripts/sync-design-tokens.mjs --check",
    "dry:check": "node scripts/check-dry-invariants.mjs"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@paddletoday/geo": "*",
    "astro": "^7.1.3",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@playwright/test": "^1.61.1",
    "eas-cli": "^18.13.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13",
    "ajv": "8.20.0",
    "joi": "17.13.4",
    "node-forge": "1.4.0",
    "tar": "7.5.22",
    "websocket-driver": "0.7.5",
    "yaml": "2.9.0"
  },
  "description": "`canoe-adventures-v2` is the new codebase for a reset version of Paddle Today.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EckceptionalSolutions/PaddleTodayV2.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/EckceptionalSolutions/PaddleTodayV2/issues"
  },
  "homepage": "https://github.com/EckceptionalSolutions/PaddleTodayV2#readme"
}
